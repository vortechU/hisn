<?xml version="1.0" encoding="utf-8"?>
<!--
    The ground a widget is drawn on: the field for the focal widgets, the paper
    for the reading ones.

    Set as an ImageView src and recoloured at runtime with setColorFilter, which
    is SRC_ATOP: it replaces the RGB outright and keeps only the source alpha.
    That is what lets one drawable serve every palette in both brightnesses on
    minSdk 21, where background tint lists (API 31) are not available.

    The authored colour is Qibla's field, so the widget picker's preview shows
    the app's default scheme rather than a white slab.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#0F3D4C" />
    <corners android:radius="@dimen/widget_radius" />
</shape>
