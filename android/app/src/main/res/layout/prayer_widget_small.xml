<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root_small"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/small_hijri"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#7FA6B8"
        android:textSize="11sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/small_next_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="#FFD98A"
        android:textSize="10sp"
        android:letterSpacing="0.12"
        android:maxLines="1"
        android:text="NEXT" />

    <TextView
        android:id="@+id/small_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="—" />

    <TextView
        android:id="@+id/small_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#C7DCE6"
        android:textSize="13sp"
        android:maxLines="1"
        android:text="—" />

    <Chronometer
        android:id="@+id/small_countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="#FFD98A"
        android:textSize="18sp"
        android:textStyle="bold"
        android:maxLines="1" />

    <TextView
        android:id="@+id/small_countdown_static"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="#FFD98A"
        android:textSize="18sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:visibility="gone" />
</LinearLayout>
