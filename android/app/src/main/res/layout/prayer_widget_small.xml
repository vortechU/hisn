<?xml version="1.0" encoding="utf-8"?>
<!--
    The compact widget, on the field: the next prayer, the live countdown to it,
    its time, and the day as five dots. For the first minutes after an adhan it
    turns to the prayer just called and counts up from it instead.

    The countdown is the hero, as it is in the app's header; the name above it
    says what it counts to. Lines are dropped from the bottom as the widget is
    made shorter (see PrayerWidgetSmallProvider), so the smallest cell a
    launcher allows still holds the name and the count.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root_small"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_mask"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/widget_ground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@null"
        android:src="@drawable/widget_sheet" />

    <ImageView
        android:id="@+id/widget_star"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="-44dp"
        android:layout_marginEnd="-44dp"
        android:contentDescription="@null"
        android:src="@drawable/widget_star"
        android:tint="#264E5C" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/small_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/readex_pro_semibold"
            android:textColor="#F4F1E8"
            android:textSize="18sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Maghrib" />

        <Chronometer
            android:id="@+id/small_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/readex_pro_medium"
            android:textColor="#F4F1E8"
            android:textSize="28sp"
            android:includeFontPadding="false"
            android:maxLines="1" />

        <TextView
            android:id="@+id/small_countdown_static"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/readex_pro_medium"
            android:textColor="#F4F1E8"
            android:textSize="28sp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:visibility="gone" />

        <TextView
            android:id="@+id/small_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/readex_pro_regular"
            android:textColor="#D8DBD5"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Next · 6:01 PM" />

        <LinearLayout
            android:id="@+id/small_dots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/dot_fajr"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:contentDescription="@null"
                android:src="@drawable/widget_dot_inset"
                android:tint="#F4F1E8" />

            <ImageView
                android:id="@+id/dot_dhuhr"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginStart="6dp"
                android:contentDescription="@null"
                android:src="@drawable/widget_dot_inset"
                android:tint="#F4F1E8" />

            <ImageView
                android:id="@+id/dot_asr"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginStart="6dp"
                android:contentDescription="@null"
                android:src="@drawable/widget_dot_inset"
                android:tint="#F4F1E8" />

            <ImageView
                android:id="@+id/dot_maghrib"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginStart="6dp"
                android:contentDescription="@null"
                android:src="@drawable/widget_ring"
                android:tint="#F4F1E8" />

            <ImageView
                android:id="@+id/dot_isha"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginStart="6dp"
                android:contentDescription="@null"
                android:src="@drawable/widget_dot_inset"
                android:tint="#7D9399" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
