<?xml version="1.0" encoding="utf-8"?>
<!--
    A verse or supplication for the day, on paper: the Arabic large and
    centred in the app's own face, the meaning beneath it, and where it is
    from above, marked with the khatam.

    The Arabic has two slots: an ImageView the provider draws it into (see
    WidgetArabic), and a plain TextView kept as the fallback for when the face
    cannot be loaded.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ayah_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_mask"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/widget_ground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@null"
        android:src="@drawable/widget_paper" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/ayah_mark"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:contentDescription="@null"
                android:src="@drawable/widget_star"
                android:tint="#0F3D4C" />

            <TextView
                android:id="@+id/ayah_source"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/readex_pro_medium"
                android:textColor="#0F3D4C"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Al-Baqarah 2:201" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="4dp" />

        <ImageView
            android:id="@+id/ayah_arabic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:contentDescription="@null"
            android:visibility="gone" />

        <TextView
            android:id="@+id/ayah_arabic_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#161A1C"
            android:textSize="19sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:text="رَبَّنَا آتِنَا فِي الدُّنْيَا حَسَنَةً وَفِي الْآخِرَةِ حَسَنَةً" />

        <TextView
            android:id="@+id/ayah_translation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:fontFamily="@font/readex_pro_regular"
            android:textColor="#5F6263"
            android:textSize="13sp"
            android:lineSpacingMultiplier="1.1"
            android:maxLines="2"
            android:ellipsize="end"
            android:text="Our Lord, give us good in this world and good in the Hereafter." />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="2dp" />
    </LinearLayout>
</FrameLayout>
