<?xml version="1.0" encoding="utf-8"?>
<!--
    One verse or supplication, changing with the day.

    The Arabic is drawn in the app's own face rather than set in a TextView —
    it is the largest thing on the widget and the whole reason the panel is
    worth having, so it cannot be left to whatever naskh the launcher's system
    font supplies. The TextView beneath is the fallback for when that font
    cannot be loaded.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ayah_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_ground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@null"
        android:src="@drawable/widget_sheet" />

    <ImageView
        android:id="@+id/widget_frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="7dp"
        android:scaleType="fitXY"
        android:contentDescription="@null"
        android:src="@drawable/widget_jadwal" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="15dp">

        <!-- A ruled heading with a rosette set into it, as a section mark. -->
        <ImageView
            android:id="@+id/ayah_rule"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:scaleType="fitXY"
            android:contentDescription="@null" />

        <ImageView
            android:id="@+id/ayah_arabic"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="6dp"
            android:scaleType="fitCenter"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/ayah_arabic_text"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:textColor="#221E18"
            android:textSize="17sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:visibility="gone" />

        <TextView
            android:id="@+id/ayah_translation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center"
            android:textColor="#6B6459"
            android:textSize="11sp"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/ayah_source"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center"
            android:textColor="#9C7B2E"
            android:textSize="9sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>
</FrameLayout>
