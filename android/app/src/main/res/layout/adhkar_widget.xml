<?xml version="1.0" encoding="utf-8"?>
<!--
    The set of adhkar that belongs to this part of the day, and how far through
    it you are.

    Which set that is follows the current prayer period rather than the wall
    clock — the same rule RecommendedAdhkar applies in the app, because morning
    adhkar are tied to Fajr and evening to Asr, not to noon.

    Progress is a drawn rule rather than two weighted views: a bar assembled
    from layout_weight snaps to whole pixels, which makes "1 of 23" look like
    nothing at all.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/adhkar_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_ground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@null"
        android:src="@drawable/widget_sheet" />

    <ImageView
        android:id="@+id/widget_frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="7dp"
        android:scaleType="fitXY"
        android:contentDescription="@null"
        android:src="@drawable/widget_jadwal" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="15dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/adhkar_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#9C7B2E"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.14"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="NOW" />

            <TextView
                android:id="@+id/adhkar_tally"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="#6B6459"
                android:textSize="11sp"
                android:maxLines="1" />
        </LinearLayout>

        <TextView
            android:id="@+id/adhkar_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#221E18"
            android:textSize="17sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="—" />

        <!-- Arabic title slot, used when the interface is Arabic. -->
        <ImageView
            android:id="@+id/adhkar_title_arabic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:adjustViewBounds="true"
            android:scaleType="fitStart"
            android:visibility="gone"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/adhkar_subtitle"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="2dp"
            android:textColor="#6B6459"
            android:textSize="11sp"
            android:maxLines="2"
            android:ellipsize="end" />

        <ImageView
            android:id="@+id/adhkar_progress"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="6dp"
            android:scaleType="fitXY"
            android:contentDescription="@null" />
    </LinearLayout>
</FrameLayout>
