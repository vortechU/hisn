<?xml version="1.0" encoding="utf-8"?>
<!--
    The adhkar set for this part of the day, on paper: what it is, how far
    through it you are, and whether the day's two fortifying sets are done.

    Reads the same way as the "recommended now" block in the app's mihrab: the
    set's name in the reader's script with its Arabic name across from it, the
    tally, a rounded bar. Under it, the morning and evening sets as two chips,
    so a glance at the home screen answers "have I said them today?". Lines are
    dropped from the bottom as the widget gets shorter (see AdhkarWidgetProvider).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/adhkar_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_mask"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/widget_ground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@null"
        android:src="@drawable/widget_paper" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/adhkar_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/readex_pro_regular"
                android:textColor="#5F6263"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Recommended now" />

            <TextView
                android:id="@+id/adhkar_tally"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textDirection="ltr"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/readex_pro_medium"
                android:textColor="#0F3D4C"
                android:textSize="12sp"
                android:maxLines="1"
                android:text="3 / 12" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:baselineAligned="false">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/adhkar_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/readex_pro_semibold"
                    android:textColor="#161A1C"
                    android:textSize="17sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="Morning adhkar" />

                <TextView
                    android:id="@+id/adhkar_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:fontFamily="@font/readex_pro_regular"
                    android:textColor="#5F6263"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="Recited after Fajr until sunrise" />
            </LinearLayout>

            <ImageView
                android:id="@+id/adhkar_title_arabic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:maxWidth="130dp"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:contentDescription="@null"
                android:visibility="gone" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="12dp">

            <ImageView
                android:id="@+id/adhkar_progress_track"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:contentDescription="@null"
                android:src="@drawable/widget_pill"
                android:tint="#E6E9E7" />

            <ImageView
                android:id="@+id/adhkar_progress"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:contentDescription="@null" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="10dp" />

        <LinearLayout
            android:id="@+id/adhkar_sessions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/chip_morning_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"
                    android:contentDescription="@null"
                    android:src="@drawable/widget_pill"
                    android:tint="#EEF0EE" />

                <!-- match_parent so the frame stretches the pill behind it:
                     FrameLayout only re-measures its match_parent children to
                     its own size when there are two or more of them. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp">

                    <ImageView
                        android:id="@+id/chip_morning_icon"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_widget_check"
                        android:tint="#93681D" />

                    <TextView
                        android:id="@+id/chip_morning_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="@font/readex_pro_medium"
                        android:textColor="#161A1C"
                        android:textSize="12sp"
                        android:maxLines="1"
                        android:text="Morning" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp">

                <ImageView
                    android:id="@+id/chip_evening_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"
                    android:contentDescription="@null"
                    android:src="@drawable/widget_pill"
                    android:tint="#EEF0EE" />

                <!-- match_parent so the frame stretches the pill behind it:
                     FrameLayout only re-measures its match_parent children to
                     its own size when there are two or more of them. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp">

                    <ImageView
                        android:id="@+id/chip_evening_icon"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:padding="2dp"
                        android:contentDescription="@null"
                        android:src="@drawable/widget_ring"
                        android:tint="#8A8D8E" />

                    <TextView
                        android:id="@+id/chip_evening_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:fontFamily="@font/readex_pro_medium"
                        android:textColor="#161A1C"
                        android:textSize="12sp"
                        android:maxLines="1"
                        android:text="Evening" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
