<?xml version="1.0" encoding="utf-8"?>
<!--
    Where the reader left off in the mushaf, on paper: the sūrah in the
    reader's script, where it sits, and its Arabic name across from it, behind
    a book in a field-coloured well. One tap reopens the page.

    A single row, so it fits a launcher's one-cell height; made taller it
    simply centres.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quran_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_mask"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/widget_ground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@null"
        android:src="@drawable/widget_paper" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="18dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:baselineAligned="false">

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp">

            <ImageView
                android:id="@+id/quran_well"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:src="@drawable/widget_dot"
                android:tint="#0F3D4C" />

            <ImageView
                android:id="@+id/quran_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_widget_book"
                android:tint="#F4F1E8" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/quran_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/readex_pro_semibold"
                android:textColor="#161A1C"
                android:textSize="15sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Surah Al-Kahf" />

            <TextView
                android:id="@+id/quran_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="@font/readex_pro_regular"
                android:textColor="#5F6263"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Continue reading · Juz 15" />
        </LinearLayout>

        <ImageView
            android:id="@+id/quran_arabic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:maxWidth="120dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:contentDescription="@null"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
