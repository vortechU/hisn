<?xml version="1.0" encoding="utf-8"?>
<!--
    The tasbih: tap the widget to count.

    The bead meter is the same one the Tasbih screen draws (WidgetOrnament
    .beadMeter) — an arc for the exact fraction and beads that ink in one at a
    time, so a glance says roughly where you are without reading the numeral.

    There is deliberately no reset control here. A misplaced tap on a home
    screen would throw away a count of eighty, and the widget's whole purpose is
    to be tapped; reset stays in the app, one deliberate journey away. Tapping
    the phrase opens the Tasbih screen, where it lives.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tasbih_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_ground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@null"
        android:src="@drawable/widget_sheet" />

    <ImageView
        android:id="@+id/widget_frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="7dp"
        android:scaleType="fitXY"
        android:contentDescription="@null"
        android:src="@drawable/widget_jadwal" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="12dp">

        <!-- The phrase, set in the app's Arabic face. The TextView below is the
             fallback for when that font cannot be loaded. -->
        <ImageView
            android:id="@+id/tasbih_phrase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/tasbih_phrase_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#0C5A4C"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:visibility="gone" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="4dp">

            <ImageView
                android:id="@+id/tasbih_meter"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/tasbih_count"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textColor="#221E18"
                android:textSize="26sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:text="0" />
        </FrameLayout>

        <TextView
            android:id="@+id/tasbih_target"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:textColor="#6B6459"
            android:textSize="10sp"
            android:maxLines="1"
            android:text="of 33" />
    </LinearLayout>
</FrameLayout>
