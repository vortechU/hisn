<?xml version="1.0" encoding="utf-8"?>
<!--
    The tasbih, on the field: the phrase in the app's Arabic face, and the
    count inside the same ring of beads the Tasbih screen draws.

    The whole face is the button, as the screen's ring is: a tap anywhere
    counts. The phrase alone opens the app, for changing it or resetting.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tasbih_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_mask"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/widget_ground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@null"
        android:src="@drawable/widget_sheet" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="12dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/tasbih_phrase"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:contentDescription="@null"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tasbih_phrase_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:fontFamily="@font/readex_pro_medium"
                android:textColor="#F4F1E8"
                android:textSize="14sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="سُبْحَانَ اللَّهِ" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="6dp">

            <ImageView
                android:id="@+id/tasbih_meter"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:contentDescription="@null"
                android:src="@drawable/widget_ring"
                android:tint="#3F6874" />

            <ImageView
                android:id="@+id/tasbih_meter_run"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <TextView
                    android:id="@+id/tasbih_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/readex_pro_medium"
                    android:textColor="#F4F1E8"
                    android:textSize="30sp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="12" />

                <TextView
                    android:id="@+id/tasbih_target"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textDirection="ltr"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/readex_pro_regular"
                    android:textColor="#D8DBD5"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:text="/ 33" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
