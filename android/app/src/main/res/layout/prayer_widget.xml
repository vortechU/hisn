<?xml version="1.0" encoding="utf-8"?>
<!--
    The day's five prayers as a timeline, on the field.

    A single launcher row shows the names and times, with the next prayer
    lifted. Resizing taller reveals the track, then the head. The head is
    the app's mihrab in small: the countdown to the next prayer and
    what it counts to, with the Hijri date and the place across from it. Under
    it, five equal columns (name, a slice of the day track, time) so the nodes
    on the track sit exactly over their own names however the launcher sizes
    the widget. The track is drawn whole and cut into the five slices (see
    PrayerWidgetProvider), and the next prayer's column is lifted on a faint
    panel, as the next row is in the app's timetable.

    Every colour here is a placeholder in Qibla light. The widget picker renders
    this file cold, with no provider running, so the authored values are what
    the preview shows; the provider replaces all of them at runtime from the
    palette Flutter pushed.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_mask"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/widget_ground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@null"
        android:src="@drawable/widget_sheet" />

    <LinearLayout
        android:id="@+id/prayer_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">

        <LinearLayout
            android:id="@+id/prayer_head"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:baselineAligned="false"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <Chronometer
                    android:id="@+id/prayer_countdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/readex_pro_medium"
                    android:textColor="#F4F1E8"
                    android:textSize="30sp"
                    android:includeFontPadding="false"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/prayer_countdown_static"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/readex_pro_medium"
                    android:textColor="#F4F1E8"
                    android:textSize="30sp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/prayer_lead"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/readex_pro_regular"
                    android:textColor="#D8DBD5"
                    android:textSize="13sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:text="Next · Maghrib 6:01 PM" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/prayer_aside"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:orientation="vertical"
                android:gravity="end">

                <TextView
                    android:id="@+id/prayer_hijri"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/readex_pro_medium"
                    android:textColor="#F4F1E8"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:text="12 Rabiʿ II 1448" />

                <TextView
                    android:id="@+id/prayer_place"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/readex_pro_regular"
                    android:textColor="#D8DBD5"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:maxWidth="140dp"
                    android:ellipsize="end"
                    android:text="Makkah" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/prayer_head_gap"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/lift_fajr"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"
                    android:contentDescription="@null"
                    android:src="@drawable/widget_panel"
                    android:visibility="invisible" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp">

                    <TextView
                        android:id="@+id/name_fajr"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/readex_pro_regular"
                        android:textColor="#C9CECB"
                        android:textSize="12sp"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="Fajr" />

                    <ImageView
                        android:id="@+id/track_fajr"
                        android:layout_width="match_parent"
                        android:layout_height="18dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="4dp"
                        android:scaleType="fitXY"
                        android:visibility="gone"
                        android:contentDescription="@null"
                        android:src="@drawable/widget_track_preview" />

                    <TextView
                        android:id="@+id/time_fajr"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/readex_pro_medium"
                        android:textColor="#C9CECB"
                        android:textSize="13sp"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="4:51 AM" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/lift_dhuhr"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"
                    android:contentDescription="@null"
                    android:src="@drawable/widget_panel"
                    android:visibility="invisible" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp">

                    <TextView
                        android:id="@+id/name_dhuhr"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/readex_pro_regular"
                        android:textColor="#C9CECB"
                        android:textSize="12sp"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="Dhuhr" />

                    <ImageView
                        android:id="@+id/track_dhuhr"
                        android:layout_width="match_parent"
                        android:layout_height="18dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="4dp"
                        android:scaleType="fitXY"
                        android:visibility="gone"
                        android:contentDescription="@null"
                        android:src="@drawable/widget_track_preview" />

                    <TextView
                        android:id="@+id/time_dhuhr"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/readex_pro_medium"
                        android:textColor="#C9CECB"
                        android:textSize="13sp"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="12:14 PM" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/lift_asr"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"
                    android:contentDescription="@null"
                    android:src="@drawable/widget_panel"
                    android:visibility="invisible" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp">

                    <TextView
                        android:id="@+id/name_asr"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/readex_pro_regular"
                        android:textColor="#C9CECB"
                        android:textSize="12sp"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="Asr" />

                    <ImageView
                        android:id="@+id/track_asr"
                        android:layout_width="match_parent"
                        android:layout_height="18dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="4dp"
                        android:scaleType="fitXY"
                        android:visibility="gone"
                        android:contentDescription="@null"
                        android:src="@drawable/widget_track_preview" />

                    <TextView
                        android:id="@+id/time_asr"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/readex_pro_medium"
                        android:textColor="#C9CECB"
                        android:textSize="13sp"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="3:32 PM" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/lift_maghrib"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"
                    android:contentDescription="@null"
                    android:src="@drawable/widget_panel"
                    android:tint="#264E5C" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp">

                    <TextView
                        android:id="@+id/name_maghrib"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/readex_pro_regular"
                        android:textColor="#F4F1E8"
                        android:textSize="12sp"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="Maghrib" />

                    <ImageView
                        android:id="@+id/track_maghrib"
                        android:layout_width="match_parent"
                        android:layout_height="18dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="4dp"
                        android:scaleType="fitXY"
                        android:visibility="gone"
                        android:contentDescription="@null"
                        android:src="@drawable/widget_track_preview" />

                    <TextView
                        android:id="@+id/time_maghrib"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/readex_pro_medium"
                        android:textColor="#F4F1E8"
                        android:textSize="13sp"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="6:01 PM" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/lift_isha"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitXY"
                    android:contentDescription="@null"
                    android:src="@drawable/widget_panel"
                    android:visibility="invisible" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp">

                    <TextView
                        android:id="@+id/name_isha"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/readex_pro_regular"
                        android:textColor="#D8DBD5"
                        android:textSize="12sp"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="Isha" />

                    <ImageView
                        android:id="@+id/track_isha"
                        android:layout_width="match_parent"
                        android:layout_height="18dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="4dp"
                        android:scaleType="fitXY"
                        android:visibility="gone"
                        android:contentDescription="@null"
                        android:src="@drawable/widget_track_preview" />

                    <TextView
                        android:id="@+id/time_isha"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/readex_pro_medium"
                        android:textColor="#F4F1E8"
                        android:textSize="13sp"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="7:21 PM" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/prayer_ornament"
        android:layout_width="80dp"
        android:layout_height="7dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="1dp"
        android:contentDescription="@null"
        android:src="@drawable/prayer_widget_ornament"
        android:tint="#385D68" />
</FrameLayout>
