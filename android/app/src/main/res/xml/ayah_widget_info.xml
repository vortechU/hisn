<?xml version="1.0" encoding="utf-8"?>
<!--
    The item changes once a day. The half-hourly tick is what rolls it over
    after midnight — a widget cannot schedule itself for an exact moment without
    an alarm, and one is not worth spending here.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:description="@string/widget_ayah_description"
    android:initialLayout="@layout/ayah_widget"
    android:previewLayout="@layout/ayah_widget"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
