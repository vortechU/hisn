<?xml version="1.0" encoding="utf-8"?>
<!--
    updatePeriodMillis is 0: the reading position only moves when a page is
    turned in the app, which pushes it and redraws the widget then.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="50dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="40dp"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:description="@string/widget_quran_description"
    android:initialLayout="@layout/quran_widget"
    android:previewLayout="@layout/quran_widget"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen" />
