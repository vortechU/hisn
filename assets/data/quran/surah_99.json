{"number":99,"name":"الزِّلْزَالِ","ayahs":[{"n":1,"text":"إِذَا زُلۡزِلَتِ ٱلۡأَرۡضُ زِلۡزَالَهَا","juz":30,"page":599},{"n":2,"text":"وَأَخۡرَجَتِ ٱلۡأَرۡضُ أَثۡقَالَهَا","juz":30,"page":599},{"n":3,"text":"وَقَالَ ٱلۡإِنسَٰنُ مَا لَهَا","juz":30,"page":599},{"n":4,"text":"يَوۡمَئِذࣲ تُحَدِّثُ أَخۡبَارَهَا","juz":30,"page":599},{"n":5,"text":"بِأَنَّ رَبَّكَ أَوۡحَىٰ لَهَا","juz":30,"page":599},{"n":6,"text":"يَوۡمَئِذࣲ يَصۡدُرُ ٱلنَّاسُ أَشۡتَاتࣰ ا لِّيُرَوۡاْ أَعۡمَٰلَهُمۡ","juz":30,"page":599},{"n":7,"text":"فَمَن يَعۡمَلۡ مِثۡقَالَ ذَرَّةٍ خَيۡرࣰ ا يَرَهُۥ","juz":30,"page":599},{"n":8,"text":"وَمَن يَعۡمَلۡ مِثۡقَالَ ذَرَّةࣲ شَرࣰّ ا يَرَهُۥ","juz":30,"page":599}]}