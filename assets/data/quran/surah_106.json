{"number":106,"name":"قُرَيْشٍ","ayahs":[{"n":1,"text":"لِإِيلَٰفِ قُرَيۡشٍ","juz":30,"page":602},{"n":2,"text":"إِۦلَٰفِهِمۡ رِحۡلَةَ ٱلشِّتَآءِ وَٱلصَّيۡفِ","juz":30,"page":602},{"n":3,"text":"فَلۡيَعۡبُدُواْ رَبَّ هَٰذَا ٱلۡبَيۡتِ","juz":30,"page":602},{"n":4,"text":"ٱلَّذِيٓ أَطۡعَمَهُم مِّن جُوعࣲ وَءَامَنَهُم مِّنۡ خَوۡفِۭ","juz":30,"page":602}]}