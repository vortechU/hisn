{"number":55,"name":"الرَّحْمٰنِ","ayahs":[{"n":1,"text":"ٱلرَّحۡمَٰنُ","juz":27,"page":531},{"n":2,"text":"عَلَّمَ ٱلۡقُرۡءَانَ","juz":27,"page":531},{"n":3,"text":"خَلَقَ ٱلۡإِنسَٰنَ","juz":27,"page":531},{"n":4,"text":"عَلَّمَهُ ٱلۡبَيَانَ","juz":27,"page":531},{"n":5,"text":"ٱلشَّمۡسُ وَٱلۡقَمَرُ بِحُسۡبَانࣲ‏","juz":27,"page":531},{"n":6,"text":"وَٱلنَّجۡمُ وَٱلشَّجَرُ يَسۡجُدَانِ","juz":27,"page":531},{"n":7,"text":"وَٱلسَّمَآءَ رَفَعَهَا وَوَضَعَ ٱلۡمِيزَانَ","juz":27,"page":531},{"n":8,"text":"أَلَّا تَطۡغَوۡاْ فِي ٱلۡمِيزَانِ","juz":27,"page":531},{"n":9,"text":"وَأَقِيمُواْ ٱلۡوَزۡنَ بِٱلۡقِسۡطِ وَلَا تُخۡسِرُواْ ٱلۡمِيزَانَ","juz":27,"page":531},{"n":10,"text":"وَٱلۡأَرۡضَ وَضَعَهَا لِلۡأَنَامِ","juz":27,"page":531},{"n":11,"text":"فِيهَا فَٰكِهَةࣱ وَٱلنَّخۡلُ ذَاتُ ٱلۡأَكۡمَامِ","juz":27,"page":531},{"n":12,"text":"وَٱلۡحَبُّ ذُو ٱلۡعَصۡفِ وَٱلرَّيۡحَانُ","juz":27,"page":531},{"n":13,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","juz":27,"page":531},{"n":14,"text":"خَلَقَ ٱلۡإِنسَٰنَ مِن صَلۡصَٰلࣲ كَٱلۡفَخَّارِ","juz":27,"page":531},{"n":15,"text":"وَخَلَقَ ٱلۡجَآنَّ مِن مَّارِجࣲ مِّن نَّارࣲ‏","juz":27,"page":531},{"n":16,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","juz":27,"page":531},{"n":17,"text":"رَبُّ ٱلۡمَشۡرِقَيۡنِ وَرَبُّ ٱلۡمَغۡرِبَيۡنِ","juz":27,"page":532},{"n":18,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","juz":27,"page":532},{"n":19,"text":"مَرَجَ ٱلۡبَحۡرَيۡنِ يَلۡتَقِيَانِ","juz":27,"page":532},{"n":20,"text":"بَيۡنَهُمَا بَرۡزَخࣱ لَّا يَبۡغِيَانِ","juz":27,"page":532},{"n":21,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","juz":27,"page":532},{"n":22,"text":"يَخۡرُجُ مِنۡهُمَا ٱللُّؤۡلُؤُ وَٱلۡمَرۡجَانُ","juz":27,"page":532},{"n":23,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","juz":27,"page":532},{"n":24,"text":"وَلَهُ ٱلۡجَوَارِ ٱلۡمُنشَـَٔاتُ فِي ٱلۡبَحۡرِ كَٱلۡأَعۡلَٰمِ","juz":27,"page":532},{"n":25,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","juz":27,"page":532},{"n":26,"text":"كُلُّ مَنۡ عَلَيۡهَا فَانࣲ‏","juz":27,"page":532},{"n":27,"text":"وَيَبۡقَىٰ وَجۡهُ رَبِّكَ ذُو ٱلۡجَلَٰلِ وَٱلۡإِكۡرَامِ","juz":27,"page":532},{"n":28,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","juz":27,"page":532},{"n":29,"text":"يَسۡـَٔلُهُۥ مَن فِي ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِۚ كُلَّ يَوۡمٍ هُوَ فِي شَأۡنࣲ‏","juz":27,"page":532},{"n":30,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","juz":27,"page":532},{"n":31,"text":"سَنَفۡرُغُ لَكُمۡ أَيُّهَ ٱلثَّقَلَانِ","juz":27,"page":532},{"n":32,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","juz":27,"page":532},{"n":33,"text":"يَٰمَعۡشَرَ ٱلۡجِنِّ وَٱلۡإِنسِ إِنِ ٱسۡتَطَعۡتُمۡ أَن تَنفُذُواْ مِنۡ أَقۡطَارِ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ فَٱنفُذُواْۚ لَا تَنفُذُونَ إِلَّا بِسُلۡطَٰنࣲ‏","juz":27,"page":532},{"n":34,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","juz":27,"page":532},{"n":35,"text":"يُرۡسَلُ عَلَيۡكُمَا شُوَاظࣱ مِّن نَّارࣲ وَنُحَاسࣱ فَلَا تَنتَصِرَانِ","juz":27,"page":532},{"n":36,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","juz":27,"page":532},{"n":37,"text":"فَإِذَا ٱنشَقَّتِ ٱلسَّمَآءُ فَكَانَتۡ وَرۡدَةࣰ كَٱلدِّهَانِ","juz":27,"page":532},{"n":38,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","juz":27,"page":532},{"n":39,"text":"فَيَوۡمَئِذࣲ لَّا يُسۡـَٔلُ عَن ذَنۢبِهِۦٓ إِنسࣱ وَلَا جَآنࣱّ‏","juz":27,"page":532},{"n":40,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","juz":27,"page":532},{"n":41,"text":"يُعۡرَفُ ٱلۡمُجۡرِمُونَ بِسِيمَٰهُمۡ فَيُؤۡخَذُ بِٱلنَّوَٰصِي وَٱلۡأَقۡدَامِ","juz":27,"page":533},{"n":42,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","juz":27,"page":533},{"n":43,"text":"هَٰذِهِۦ جَهَنَّمُ ٱلَّتِي يُكَذِّبُ بِهَا ٱلۡمُجۡرِمُونَ","juz":27,"page":533},{"n":44,"text":"يَطُوفُونَ بَيۡنَهَا وَبَيۡنَ حَمِيمٍ ءَانࣲ‏","juz":27,"page":533},{"n":45,"text":"فَبِأَيِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ","juz":27,"page":533},{"n":46,"text":"وَلِمَنۡ خَافَ مَقَامَ رَبِّهِۦ جَنَّتَانِ","juz":27,"page":533},{"n":47,"tex