{"number":85,"name":"الْبُرُوْجِ","ayahs":[{"n":1,"text":"وَٱلسَّمَآءِ ذَاتِ ٱلۡبُرُوجِ","juz":30,"page":590},{"n":2,"text":"وَٱلۡيَوۡمِ ٱلۡمَوۡعُودِ","juz":30,"page":590},{"n":3,"text":"وَشَاهِدࣲ وَمَشۡهُودࣲ‏","juz":30,"page":590},{"n":4,"text":"قُتِلَ أَصۡحَٰبُ ٱلۡأُخۡدُودِ","juz":30,"page":590},{"n":5,"text":"ٱلنَّارِ ذَاتِ ٱلۡوَقُودِ","juz":30,"page":590},{"n":6,"text":"إِذۡ هُمۡ عَلَيۡهَا قُعُودࣱ‏","juz":30,"page":590},{"n":7,"text":"وَهُمۡ عَلَىٰ مَا يَفۡعَلُونَ بِٱلۡمُؤۡمِنِينَ شُهُودࣱ‏","juz":30,"page":590},{"n":8,"text":"وَمَا نَقَمُواْ مِنۡهُمۡ إِلَّآ أَن يُؤۡمِنُواْ بِٱللَّهِ ٱلۡعَزِيزِ ٱلۡحَمِيدِ","juz":30,"page":590},{"n":9,"text":"ٱلَّذِي لَهُۥ مُلۡكُ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِۚ وَٱللَّهُ عَلَىٰ كُلِّ شَيۡءࣲ شَهِيدٌ","juz":30,"page":590},{"n":10,"text":"إِنَّ ٱلَّذِينَ فَتَنُواْ ٱلۡمُؤۡمِنِينَ وَٱلۡمُؤۡمِنَٰتِ ثُمَّ لَمۡ يَتُوبُواْ فَلَهُمۡ عَذَابُ جَهَنَّمَ وَلَهُمۡ عَذَابُ ٱلۡحَرِيقِ","juz":30,"page":590},{"n":11,"text":"إِنَّ ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ لَهُمۡ جَنَّٰتࣱ تَجۡرِي مِن تَحۡتِهَا ٱلۡأَنۡهَٰرُۚ ذَٰلِكَ ٱلۡفَوۡزُ ٱلۡكَبِيرُ","juz":30,"page":590},{"n":12,"text":"إِنَّ بَطۡشَ رَبِّكَ لَشَدِيدٌ","juz":30,"page":590},{"n":13,"text":"إِنَّهُۥ هُوَ يُبۡدِئُ وَيُعِيدُ","juz":30,"page":590},{"n":14,"text":"وَهُوَ ٱلۡغَفُورُ ٱلۡوَدُودُ","juz":30,"page":590},{"n":15,"text":"ذُو ٱلۡعَرۡشِ ٱلۡمَجِيدُ","juz":30,"page":590},{"n":16,"text":"فَعَّالࣱ لِّمَا يُرِيدُ","juz":30,"page":590},{"n":17,"text":"هَلۡ أَتَىٰكَ حَدِيثُ ٱلۡجُنُودِ","juz":30,"page":590},{"n":18,"text":"فِرۡعَوۡنَ وَثَمُودَ","juz":30,"page":590},{"n":19,"text":"بَلِ ٱلَّذِينَ كَفَرُواْ فِي تَكۡذِيبࣲ‏","juz":30,"page":590},{"n":20,"text":"وَٱللَّهُ مِن وَرَآئِهِم مُّحِيطُۢ","juz":30,"page":590},{"n":21,"text":"بَلۡ هُوَ قُرۡءَانࣱ مَّجِيدࣱ‏","juz":30,"page":590},{"n":22,"text":"فِي لَوۡحࣲ مَّحۡفُوظِۭ","juz":30,"page":590}]}