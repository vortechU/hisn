{"number":102,"name":"التَّكَاثُرِ","ayahs":[{"n":1,"text":"أَلۡهَىٰكُمُ ٱلتَّكَاثُرُ","juz":30,"page":600},{"n":2,"text":"حَتَّىٰ زُرۡتُمُ ٱلۡمَقَابِرَ","juz":30,"page":600},{"n":3,"text":"كَلَّا سَوۡفَ تَعۡلَمُونَ","juz":30,"page":600},{"n":4,"text":"ثُمَّ كَلَّا سَوۡفَ تَعۡلَمُونَ","juz":30,"page":600},{"n":5,"text":"كَلَّا لَوۡ تَعۡلَمُونَ عِلۡمَ ٱلۡيَقِينِ","juz":30,"page":600},{"n":6,"text":"لَتَرَوُنَّ ٱلۡجَحِيمَ","juz":30,"page":600},{"n":7,"text":"ثُمَّ لَتَرَوُنَّهَا عَيۡنَ ٱلۡيَقِينِ","juz":30,"page":600},{"n":8,"text":"ثُمَّ لَتُسۡـَٔلُنَّ يَوۡمَئِذٍ عَنِ ٱلنَّعِيمِ","juz":30,"page":600}]}