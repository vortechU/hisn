{"number":94,"name":"الشَّرْحِ","ayahs":[{"n":1,"text":"أَلَمۡ نَشۡرَحۡ لَكَ صَدۡرَكَ","juz":30,"page":596},{"n":2,"text":"وَوَضَعۡنَا عَنكَ وِزۡرَكَ","juz":30,"page":596},{"n":3,"text":"ٱلَّذِيٓ أَنقَضَ ظَهۡرَكَ","juz":30,"page":596},{"n":4,"text":"وَرَفَعۡنَا لَكَ ذِكۡرَكَ","juz":30,"page":596},{"n":5,"text":"فَإِنَّ مَعَ ٱلۡعُسۡرِ يُسۡرًا","juz":30,"page":596},{"n":6,"text":"إِنَّ مَعَ ٱلۡعُسۡرِ يُسۡرࣰ ا","juz":30,"page":596},{"n":7,"text":"فَإِذَا فَرَغۡتَ فَٱنصَبۡ","juz":30,"page":596},{"n":8,"text":"وَإِلَىٰ رَبِّكَ فَٱرۡغَب","juz":30,"page":596}]}