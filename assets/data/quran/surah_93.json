{"number":93,"name":"الضُّحٰي","ayahs":[{"n":1,"text":"وَٱلضُّحَىٰ","juz":30,"page":596},{"n":2,"text":"وَٱلَّيۡلِ إِذَا سَجَىٰ","juz":30,"page":596},{"n":3,"text":"مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ","juz":30,"page":596},{"n":4,"text":"وَلَلۡأٓخِرَةُ خَيۡرࣱ لَّكَ مِنَ ٱلۡأُولَىٰ","juz":30,"page":596},{"n":5,"text":"وَلَسَوۡفَ يُعۡطِيكَ رَبُّكَ فَتَرۡضَىٰٓ","juz":30,"page":596},{"n":6,"text":"أَلَمۡ يَجِدۡكَ يَتِيمࣰا فَـَٔاوَىٰ","juz":30,"page":596},{"n":7,"text":"وَوَجَدَكَ ضَآلࣰّا فَهَدَىٰ","juz":30,"page":596},{"n":8,"text":"وَوَجَدَكَ عَآئِلࣰا فَأَغۡنَىٰ","juz":30,"page":596},{"n":9,"text":"فَأَمَّا ٱلۡيَتِيمَ فَلَا تَقۡهَرۡ","juz":30,"page":596},{"n":10,"text":"وَأَمَّا ٱلسَّآئِلَ فَلَا تَنۡهَرۡ","juz":30,"page":596},{"n":11,"text":"وَأَمَّا بِنِعۡمَةِ رَبِّكَ فَحَدِّثۡ","juz":30,"page":596}]}