{"number":78,"name":"النَّبَاِ","ayahs":[{"n":1,"text":"عَمَّ يَتَسَآءَلُونَ","juz":30,"page":582},{"n":2,"text":"عَنِ ٱلنَّبَإِ ٱلۡعَظِيمِ","juz":30,"page":582},{"n":3,"text":"ٱلَّذِي هُمۡ فِيهِ مُخۡتَلِفُونَ","juz":30,"page":582},{"n":4,"text":"كَلَّا سَيَعۡلَمُونَ","juz":30,"page":582},{"n":5,"text":"ثُمَّ كَلَّا سَيَعۡلَمُونَ","juz":30,"page":582},{"n":6,"text":"أَلَمۡ نَجۡعَلِ ٱلۡأَرۡضَ مِهَٰدࣰ ا","juz":30,"page":582},{"n":7,"text":"وَٱلۡجِبَالَ أَوۡتَادࣰ ا","juz":30,"page":582},{"n":8,"text":"وَخَلَقۡنَٰكُمۡ أَزۡوَٰجࣰ ا","juz":30,"page":582},{"n":9,"text":"وَجَعَلۡنَا نَوۡمَكُمۡ سُبَاتࣰ ا","juz":30,"page":582},{"n":10,"text":"وَجَعَلۡنَا ٱلَّيۡلَ لِبَاسࣰ ا","juz":30,"page":582},{"n":11,"text":"وَجَعَلۡنَا ٱلنَّهَارَ مَعَاشࣰ ا","juz":30,"page":582},{"n":12,"text":"وَبَنَيۡنَا فَوۡقَكُمۡ سَبۡعࣰ ا شِدَادࣰ ا","juz":30,"page":582},{"n":13,"text":"وَجَعَلۡنَا سِرَاجࣰ ا وَهَّاجࣰ ا","juz":30,"page":582},{"n":14,"text":"وَأَنزَلۡنَا مِنَ ٱلۡمُعۡصِرَٰتِ مَآءࣰ ثَجَّاجࣰ ا","juz":30,"page":582},{"n":15,"text":"لِّنُخۡرِجَ بِهِۦ حَبࣰّ ا وَنَبَاتࣰ ا","juz":30,"page":582},{"n":16,"text":"وَجَنَّٰتٍ أَلۡفَافًا","juz":30,"page":582},{"n":17,"text":"إِنَّ يَوۡمَ ٱلۡفَصۡلِ كَانَ مِيقَٰتࣰ ا","juz":30,"page":582},{"n":18,"text":"يَوۡمَ يُنفَخُ فِي ٱلصُّورِ فَتَأۡتُونَ أَفۡوَاجࣰ ا","juz":30,"page":582},{"n":19,"text":"وَفُتِحَتِ ٱلسَّمَآءُ فَكَانَتۡ أَبۡوَٰبࣰ ا","juz":30,"page":582},{"n":20,"text":"وَسُيِّرَتِ ٱلۡجِبَالُ فَكَانَتۡ سَرَابًا","juz":30,"page":582},{"n":21,"text":"إِنَّ جَهَنَّمَ كَانَتۡ مِرۡصَادࣰ ا","juz":30,"page":582},{"n":22,"text":"لِّلطَّٰغِينَ مَـَٔابࣰ ا","juz":30,"page":582},{"n":23,"text":"لَّٰبِثِينَ فِيهَآ أَحۡقَابࣰ ا","juz":30,"page":582},{"n":24,"text":"لَّا يَذُوقُونَ فِيهَا بَرۡدࣰ ا وَلَا شَرَابًا","juz":30,"page":582},{"n":25,"text":"إِلَّا حَمِيمࣰ ا وَغَسَّاقࣰ ا","juz":30,"page":582},{"n":26,"text":"جَزَآءࣰ وِفَاقًا","juz":30,"page":582},{"n":27,"text":"إِنَّهُمۡ كَانُواْ لَا يَرۡجُونَ حِسَابࣰ ا","juz":30,"page":582},{"n":28,"text":"وَكَذَّبُواْ بِـَٔايَٰتِنَا كِذَّابࣰ ا","juz":30,"page":582},{"n":29,"text":"وَكُلَّ شَيۡءٍ أَحۡصَيۡنَٰهُ كِتَٰبࣰ ا","juz":30,"page":582},{"n":30,"text":"فَذُوقُواْ فَلَن نَّزِيدَكُمۡ إِلَّا عَذَابًا","juz":30,"page":582},{"n":31,"text":"إِنَّ لِلۡمُتَّقِينَ مَفَازًا","juz":30,"page":583},{"n":32,"text":"حَدَآئِقَ وَأَعۡنَٰبࣰ ا","juz":30,"page":583},{"n":33,"text":"وَكَوَاعِبَ أَتۡرَابࣰ ا","juz":30,"page":583},{"n":34,"text":"وَكَأۡسࣰ ا دِهَاقࣰ ا","juz":30,"page":583},{"n":35,"text":"لَّا يَسۡمَعُونَ فِيهَا لَغۡوࣰ ا وَلَا كِذَّٰبࣰ ا","juz":30,"page":583},{"n":36,"text":"جَزَآءࣰ مِّن رَّبِّكَ عَطَآءً حِسَابࣰ ا","juz":30,"page":583},{"n":37,"text":"رَّبِّ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ وَمَا بَيۡنَهُمَا ٱلرَّحۡمَٰنِۖ لَا يَمۡلِكُونَ مِنۡهُ خِطَابࣰ ا","juz":30,"page":583},{"n":38,"text":"يَوۡمَ يَقُومُ ٱلرُّوحُ وَٱلۡمَلَٰٓئِكَةُ صَفࣰّ اۖ لَّا يَتَكَلَّمُونَ إِلَّا مَنۡ أَذِنَ لَهُ ٱلرَّحۡمَٰنُ وَقَالَ صَوَابࣰ ا","juz":30,"page":583},{"n":39,"text":"ذَٰلِكَ ٱلۡيَوۡمُ ٱلۡحَقُّۖ فَمَن شَآءَ ٱتَّخَذَ إِلَىٰ رَبِّهِۦ مَـَٔابًا","juz":30,"page":583},{"n":40,"text":"إِنَّآ أَنذَرۡنَٰكُمۡ عَذَابࣰ ا قَرِيبࣰ ا يَوۡمَ يَنظُرُ ٱلۡمَرۡءُ مَا قَدَّمَتۡ يَدَاهُ وَيَقُولُ ٱلۡكَافِرُ يَٰلَيۡتَنِي كُنتُ تُرَٰبَۢا","juz":30,"page":583}]}