{"number":87,"name":"الْاَعْلٰي","ayahs":[{"n":1,"text":"سَبِّحِ ٱسۡمَ رَبِّكَ ٱلۡأَعۡلَى","juz":30,"page":591},{"n":2,"text":"ٱلَّذِي خَلَقَ فَسَوَّىٰ","juz":30,"page":591},{"n":3,"text":"وَٱلَّذِي قَدَّرَ فَهَدَىٰ","juz":30,"page":591},{"n":4,"text":"وَٱلَّذِيٓ أَخۡرَجَ ٱلۡمَرۡعَىٰ","juz":30,"page":591},{"n":5,"text":"فَجَعَلَهُۥ غُثَآءً أَحۡوَىٰ","juz":30,"page":591},{"n":6,"text":"سَنُقۡرِئُكَ فَلَا تَنسَىٰٓ","juz":30,"page":591},{"n":7,"text":"إِلَّا مَا شَآءَ ٱللَّهُۚ إِنَّهُۥ يَعۡلَمُ ٱلۡجَهۡرَ وَمَا يَخۡفَىٰ","juz":30,"page":591},{"n":8,"text":"وَنُيَسِّرُكَ لِلۡيُسۡرَىٰ","juz":30,"page":591},{"n":9,"text":"فَذَكِّرۡ إِن نَّفَعَتِ ٱلذِّكۡرَىٰ","juz":30,"page":591},{"n":10,"text":"سَيَذَّكَّرُ مَن يَخۡشَىٰ","juz":30,"page":591},{"n":11,"text":"وَيَتَجَنَّبُهَا ٱلۡأَشۡقَى","juz":30,"page":591},{"n":12,"text":"ٱلَّذِي يَصۡلَى ٱلنَّارَ ٱلۡكُبۡرَىٰ","juz":30,"page":591},{"n":13,"text":"ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحۡيَىٰ","juz":30,"page":591},{"n":14,"text":"قَدۡ أَفۡلَحَ مَن تَزَكَّىٰ","juz":30,"page":591},{"n":15,"text":"وَذَكَرَ ٱسۡمَ رَبِّهِۦ فَصَلَّىٰ","juz":30,"page":591},{"n":16,"text":"بَلۡ تُؤۡثِرُونَ ٱلۡحَيَوٰةَ ٱلدُّنۡيَا","juz":30,"page":592},{"n":17,"text":"وَٱلۡأٓخِرَةُ خَيۡرࣱ وَأَبۡقَىٰٓ","juz":30,"page":592},{"n":18,"text":"إِنَّ هَٰذَا لَفِي ٱلصُّحُفِ ٱلۡأُولَىٰ","juz":30,"page":592},{"n":19,"text":"صُحُفِ إِبۡرَٰهِيمَ وَمُوسَىٰ","juz":30,"page":592}]}