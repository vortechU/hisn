{"number":104,"name":"الْهُمَزَةِ","ayahs":[{"n":1,"text":"وَيۡلࣱ لِّكُلِّ هُمَزَةࣲ لُّمَزَةٍ","juz":30,"page":601},{"n":2,"text":"ٱلَّذِي جَمَعَ مَالࣰ ا وَعَدَّدَهُۥ","juz":30,"page":601},{"n":3,"text":"يَحۡسَبُ أَنَّ مَالَهُۥٓ أَخۡلَدَهُۥ","juz":30,"page":601},{"n":4,"text":"كَلَّاۖ لَيُنۢبَذَنَّ فِي ٱلۡحُطَمَةِ","juz":30,"page":601},{"n":5,"text":"وَمَآ أَدۡرَىٰكَ مَا ٱلۡحُطَمَةُ","juz":30,"page":601},{"n":6,"text":"نَارُ ٱللَّهِ ٱلۡمُوقَدَةُ","juz":30,"page":601},{"n":7,"text":"ٱلَّتِي تَطَّلِعُ عَلَى ٱلۡأَفۡـِٔدَةِ","juz":30,"page":601},{"n":8,"text":"إِنَّهَا عَلَيۡهِم مُّؤۡصَدَةࣱ‏","juz":30,"page":601},{"n":9,"text":"فِي عَمَدࣲ مُّمَدَّدَةِۭ","juz":30,"page":601}]}