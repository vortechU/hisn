{"number":1,"name":"الْفَاتِحَةِ","ayahs":[{"n":1,"text":"بِسۡمِ ٱللَّهِ ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ","juz":1,"page":1},{"n":2,"text":"ٱلۡحَمۡدُ لِلَّهِ رَبِّ ٱلۡعَٰلَمِينَ","juz":1,"page":1},{"n":3,"text":"ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ","juz":1,"page":1},{"n":4,"text":"مَٰلِكِ يَوۡمِ ٱلدِّينِ","juz":1,"page":1},{"n":5,"text":"إِيَّاكَ نَعۡبُدُ وَإِيَّاكَ نَسۡتَعِينُ","juz":1,"page":1},{"n":6,"text":"ٱهۡدِنَا ٱلصِّرَٰطَ ٱلۡمُسۡتَقِيمَ","juz":1,"page":1},{"n":7,"text":"صِرَٰطَ ٱلَّذِينَ أَنۡعَمۡتَ عَلَيۡهِمۡ غَيۡرِ ٱلۡمَغۡضُوبِ عَلَيۡهِمۡ وَلَا ٱلضَّآلِّينَ","juz":1,"page":1}]}