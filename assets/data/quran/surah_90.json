{"number":90,"name":"الْبَلَدِ","ayahs":[{"n":1,"text":"لَآ أُقۡسِمُ بِهَٰذَا ٱلۡبَلَدِ","juz":30,"page":594},{"n":2,"text":"وَأَنتَ حِلُّۢ بِهَٰذَا ٱلۡبَلَدِ","juz":30,"page":594},{"n":3,"text":"وَوَالِدࣲ وَمَا وَلَدَ","juz":30,"page":594},{"n":4,"text":"لَقَدۡ خَلَقۡنَا ٱلۡإِنسَٰنَ فِي كَبَدٍ","juz":30,"page":594},{"n":5,"text":"أَيَحۡسَبُ أَن لَّن يَقۡدِرَ عَلَيۡهِ أَحَدࣱ‏","juz":30,"page":594},{"n":6,"text":"يَقُولُ أَهۡلَكۡتُ مَالࣰ ا لُّبَدًا","juz":30,"page":594},{"n":7,"text":"أَيَحۡسَبُ أَن لَّمۡ يَرَهُۥٓ أَحَدٌ","juz":30,"page":594},{"n":8,"text":"أَلَمۡ نَجۡعَل لَّهُۥ عَيۡنَيۡنِ","juz":30,"page":594},{"n":9,"text":"وَلِسَانࣰ ا وَشَفَتَيۡنِ","juz":30,"page":594},{"n":10,"text":"وَهَدَيۡنَٰهُ ٱلنَّجۡدَيۡنِ","juz":30,"page":594},{"n":11,"text":"فَلَا ٱقۡتَحَمَ ٱلۡعَقَبَةَ","juz":30,"page":594},{"n":12,"text":"وَمَآ أَدۡرَىٰكَ مَا ٱلۡعَقَبَةُ","juz":30,"page":594},{"n":13,"text":"فَكُّ رَقَبَةٍ","juz":30,"page":594},{"n":14,"text":"أَوۡ إِطۡعَٰمࣱ فِي يَوۡمࣲ ذِي مَسۡغَبَةࣲ‏","juz":30,"page":594},{"n":15,"text":"يَتِيمࣰ ا ذَا مَقۡرَبَةٍ","juz":30,"page":594},{"n":16,"text":"أَوۡ مِسۡكِينࣰ ا ذَا مَتۡرَبَةࣲ‏","juz":30,"page":594},{"n":17,"text":"ثُمَّ كَانَ مِنَ ٱلَّذِينَ ءَامَنُواْ وَتَوَاصَوۡاْ بِٱلصَّبۡرِ وَتَوَاصَوۡاْ بِٱلۡمَرۡحَمَةِ","juz":30,"page":594},{"n":18,"text":"أُوْلَٰٓئِكَ أَصۡحَٰبُ ٱلۡمَيۡمَنَةِ","juz":30,"page":594},{"n":19,"text":"وَٱلَّذِينَ كَفَرُواْ بِـَٔايَٰتِنَا هُمۡ أَصۡحَٰبُ ٱلۡمَشۡـَٔمَةِ","juz":30,"page":594},{"n":20,"text":"عَلَيۡهِمۡ نَارࣱ مُّؤۡصَدَةُۢ","juz":30,"page":594}]}