{"number":79,"name":"النَّازِعَاتِ","ayahs":[{"n":1,"text":"وَٱلنَّٰزِعَٰتِ غَرۡقࣰ ا","juz":30,"page":583},{"n":2,"text":"وَٱلنَّٰشِطَٰتِ نَشۡطࣰ ا","juz":30,"page":583},{"n":3,"text":"وَٱلسَّٰبِحَٰتِ سَبۡحࣰ ا","juz":30,"page":583},{"n":4,"text":"فَٱلسَّٰبِقَٰتِ سَبۡقࣰ ا","juz":30,"page":583},{"n":5,"text":"فَٱلۡمُدَبِّرَٰتِ أَمۡرࣰ ا","juz":30,"page":583},{"n":6,"text":"يَوۡمَ تَرۡجُفُ ٱلرَّاجِفَةُ","juz":30,"page":583},{"n":7,"text":"تَتۡبَعُهَا ٱلرَّادِفَةُ","juz":30,"page":583},{"n":8,"text":"قُلُوبࣱ يَوۡمَئِذࣲ وَاجِفَةٌ","juz":30,"page":583},{"n":9,"text":"أَبۡصَٰرُهَا خَٰشِعَةࣱ‏","juz":30,"page":583},{"n":10,"text":"يَقُولُونَ أَءِنَّا لَمَرۡدُودُونَ فِي ٱلۡحَافِرَةِ","juz":30,"page":583},{"n":11,"text":"أَءِذَا كُنَّا عِظَٰمࣰ ا نَّخِرَةࣰ‏","juz":30,"page":583},{"n":12,"text":"قَالُواْ تِلۡكَ إِذࣰ ا كَرَّةٌ خَاسِرَةࣱ‏","juz":30,"page":583},{"n":13,"text":"فَإِنَّمَا هِيَ زَجۡرَةࣱ وَٰحِدَةࣱ‏","juz":30,"page":583},{"n":14,"text":"فَإِذَا هُم بِٱلسَّاهِرَةِ","juz":30,"page":583},{"n":15,"text":"هَلۡ أَتَىٰكَ حَدِيثُ مُوسَىٰٓ","juz":30,"page":583},{"n":16,"text":"إِذۡ نَادَىٰهُ رَبُّهُۥ بِٱلۡوَادِ ٱلۡمُقَدَّسِ طُوًى","juz":30,"page":584},{"n":17,"text":"ٱذۡهَبۡ إِلَىٰ فِرۡعَوۡنَ إِنَّهُۥ طَغَىٰ","juz":30,"page":584},{"n":18,"text":"فَقُلۡ هَل لَّكَ إِلَىٰٓ أَن تَزَكَّىٰ","juz":30,"page":584},{"n":19,"text":"وَأَهۡدِيَكَ إِلَىٰ رَبِّكَ فَتَخۡشَىٰ","juz":30,"page":584},{"n":20,"text":"فَأَرَىٰهُ ٱلۡأٓيَةَ ٱلۡكُبۡرَىٰ","juz":30,"page":584},{"n":21,"text":"فَكَذَّبَ وَعَصَىٰ","juz":30,"page":584},{"n":22,"text":"ثُمَّ أَدۡبَرَ يَسۡعَىٰ","juz":30,"page":584},{"n":23,"text":"فَحَشَرَ فَنَادَىٰ","juz":30,"page":584},{"n":24,"text":"فَقَالَ أَنَا۠ رَبُّكُمُ ٱلۡأَعۡلَىٰ","juz":30,"page":584},{"n":25,"text":"فَأَخَذَهُ ٱللَّهُ نَكَالَ ٱلۡأٓخِرَةِ وَٱلۡأُولَىٰٓ","juz":30,"page":584},{"n":26,"text":"إِنَّ فِي ذَٰلِكَ لَعِبۡرَةࣰ لِّمَن يَخۡشَىٰٓ","juz":30,"page":584},{"n":27,"text":"ءَأَنتُمۡ أَشَدُّ خَلۡقًا أَمِ ٱلسَّمَآءُۚ بَنَىٰهَا","juz":30,"page":584},{"n":28,"text":"رَفَعَ سَمۡكَهَا فَسَوَّىٰهَا","juz":30,"page":584},{"n":29,"text":"وَأَغۡطَشَ لَيۡلَهَا وَأَخۡرَجَ ضُحَىٰهَا","juz":30,"page":584},{"n":30,"text":"وَٱلۡأَرۡضَ بَعۡدَ ذَٰلِكَ دَحَىٰهَآ","juz":30,"page":584},{"n":31,"text":"أَخۡرَجَ مِنۡهَا مَآءَهَا وَمَرۡعَىٰهَا","juz":30,"page":584},{"n":32,"text":"وَٱلۡجِبَالَ أَرۡسَىٰهَا","juz":30,"page":584},{"n":33,"text":"مَتَٰعࣰ ا لَّكُمۡ وَلِأَنۡعَٰمِكُمۡ","juz":30,"page":584},{"n":34,"text":"فَإِذَا جَآءَتِ ٱلطَّآمَّةُ ٱلۡكُبۡرَىٰ","juz":30,"page":584},{"n":35,"text":"يَوۡمَ يَتَذَكَّرُ ٱلۡإِنسَٰنُ مَا سَعَىٰ","juz":30,"page":584},{"n":36,"text":"وَبُرِّزَتِ ٱلۡجَحِيمُ لِمَن يَرَىٰ","juz":30,"page":584},{"n":37,"text":"فَأَمَّا مَن طَغَىٰ","juz":30,"page":584},{"n":38,"text":"وَءَاثَرَ ٱلۡحَيَوٰةَ ٱلدُّنۡيَا","juz":30,"page":584},{"n":39,"text":"فَإِنَّ ٱلۡجَحِيمَ هِيَ ٱلۡمَأۡوَىٰ","juz":30,"page":584},{"n":40,"text":"وَأَمَّا مَنۡ خَافَ مَقَامَ رَبِّهِۦ وَنَهَى ٱلنَّفۡسَ عَنِ ٱلۡهَوَىٰ","juz":30,"page":584},{"n":41,"text":"فَإِنَّ ٱلۡجَنَّةَ هِيَ ٱلۡمَأۡوَىٰ","juz":30,"page":584},{"n":42,"text":"يَسۡـَٔلُونَكَ عَنِ ٱلسَّاعَةِ أَيَّانَ مُرۡسَىٰهَا","juz":30,"page":584},{"n":43,"text":"فِيمَ أَنتَ مِن ذِكۡرَىٰهَآ","juz":30,"page":584},{"n":44,"text":"إِلَىٰ رَبِّكَ مُنتَهَىٰهَآ","juz":30,"page":584},{"n":45,"text":"إِنَّمَآ أَنتَ مُنذِرُ مَن يَخۡشَىٰهَا","juz":30,"page":584},{"n":46,"text":"كَأَنَّهُمۡ يَوۡمَ يَرَوۡنَهَا لَمۡ يَلۡبَثُوٓاْ إِلَّا عَشِيَّةً أَوۡ ضُحَىٰهَا","juz":30,"page":584}]}