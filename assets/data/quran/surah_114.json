{"number":114,"name":"النَّاسِ","ayahs":[{"n":1,"text":"قُلۡ أَعُوذُ بِرَبِّ ٱلنَّاسِ","juz":30,"page":604},{"n":2,"text":"مَلِكِ ٱلنَّاسِ","juz":30,"page":604},{"n":3,"text":"إِلَٰهِ ٱلنَّاسِ","juz":30,"page":604},{"n":4,"text":"مِن شَرِّ ٱلۡوَسۡوَاسِ ٱلۡخَنَّاسِ","juz":30,"page":604},{"n":5,"text":"ٱلَّذِي يُوَسۡوِسُ فِي صُدُورِ ٱلنَّاسِ","juz":30,"page":604},{"n":6,"text":"مِنَ ٱلۡجِنَّةِ وَٱلنَّاسِ","juz":30,"page":604}]}