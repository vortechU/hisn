{"number":74,"name":"الْمُدَّثِّرِ","ayahs":[{"n":1,"text":"يَٰٓأَيُّهَا ٱلۡمُدَّثِّرُ","juz":29,"page":575},{"n":2,"text":"قُمۡ فَأَنذِرۡ","juz":29,"page":575},{"n":3,"text":"وَرَبَّكَ فَكَبِّرۡ","juz":29,"page":575},{"n":4,"text":"وَثِيَابَكَ فَطَهِّرۡ","juz":29,"page":575},{"n":5,"text":"وَٱلرُّجۡزَ فَٱهۡجُرۡ","juz":29,"page":575},{"n":6,"text":"وَلَا تَمۡنُن تَسۡتَكۡثِرُ","juz":29,"page":575},{"n":7,"text":"وَلِرَبِّكَ فَٱصۡبِرۡ","juz":29,"page":575},{"n":8,"text":"فَإِذَا نُقِرَ فِي ٱلنَّاقُورِ","juz":29,"page":575},{"n":9,"text":"فَذَٰلِكَ يَوۡمَئِذࣲ يَوۡمٌ عَسِيرٌ","juz":29,"page":575},{"n":10,"text":"عَلَى ٱلۡكَٰفِرِينَ غَيۡرُ يَسِيرࣲ‏","juz":29,"page":575},{"n":11,"text":"ذَرۡنِي وَمَنۡ خَلَقۡتُ وَحِيدࣰ ا","juz":29,"page":575},{"n":12,"text":"وَجَعَلۡتُ لَهُۥ مَالࣰ ا مَّمۡدُودࣰ ا","juz":29,"page":575},{"n":13,"text":"وَبَنِينَ شُهُودࣰ ا","juz":29,"page":575},{"n":14,"text":"وَمَهَّدتُّ لَهُۥ تَمۡهِيدࣰ ا","juz":29,"page":575},{"n":15,"text":"ثُمَّ يَطۡمَعُ أَنۡ أَزِيدَ","juz":29,"page":575},{"n":16,"text":"كَلَّآۖ إِنَّهُۥ كَانَ لِأٓيَٰتِنَا عَنِيدࣰ ا","juz":29,"page":575},{"n":17,"text":"سَأُرۡهِقُهُۥ صَعُودًا","juz":29,"page":575},{"n":18,"text":"إِنَّهُۥ فَكَّرَ وَقَدَّرَ","juz":29,"page":576},{"n":19,"text":"فَقُتِلَ كَيۡفَ قَدَّرَ","juz":29,"page":576},{"n":20,"text":"ثُمَّ قُتِلَ كَيۡفَ قَدَّرَ","juz":29,"page":576},{"n":21,"text":"ثُمَّ نَظَرَ","juz":29,"page":576},{"n":22,"text":"ثُمَّ عَبَسَ وَبَسَرَ","juz":29,"page":576},{"n":23,"text":"ثُمَّ أَدۡبَرَ وَٱسۡتَكۡبَرَ","juz":29,"page":576},{"n":24,"text":"فَقَالَ إِنۡ هَٰذَآ إِلَّا سِحۡرࣱ يُؤۡثَرُ","juz":29,"page":576},{"n":25,"text":"إِنۡ هَٰذَآ إِلَّا قَوۡلُ ٱلۡبَشَرِ","juz":29,"page":576},{"n":26,"text":"سَأُصۡلِيهِ سَقَرَ","juz":29,"page":576},{"n":27,"text":"وَمَآ أَدۡرَىٰكَ مَا سَقَرُ","juz":29,"page":576},{"n":28,"text":"لَا تُبۡقِي وَلَا تَذَرُ","juz":29,"page":576},{"n":29,"text":"لَوَّاحَةࣱ لِّلۡبَشَرِ","juz":29,"page":576},{"n":30,"text":"عَلَيۡهَا تِسۡعَةَ عَشَرَ","juz":29,"page":576},{"n":31,"text":"وَمَا جَعَلۡنَآ أَصۡحَٰبَ ٱلنَّارِ إِلَّا مَلَٰٓئِكَةࣰۖ وَمَا جَعَلۡنَا عِدَّتَهُمۡ إِلَّا فِتۡنَةࣰ لِّلَّذِينَ كَفَرُواْ لِيَسۡتَيۡقِنَ ٱلَّذِينَ أُوتُواْ ٱلۡكِتَٰبَ وَيَزۡدَادَ ٱلَّذِينَ ءَامَنُوٓاْ إِيمَٰنࣰ ا وَلَا يَرۡتَابَ ٱلَّذِينَ أُوتُواْ ٱلۡكِتَٰبَ وَٱلۡمُؤۡمِنُونَ وَلِيَقُولَ ٱلَّذِينَ فِي قُلُوبِهِم مَّرَضࣱ وَٱلۡكَٰفِرُونَ مَاذَآ أَرَادَ ٱللَّهُ بِهَٰذَا مَثَلࣰ اۚ كَذَٰلِكَ يُضِلُّ ٱللَّهُ مَن يَشَآءُ وَيَهۡدِي مَن يَشَآءُۚ وَمَا يَعۡلَمُ جُنُودَ رَبِّكَ إِلَّا هُوَۚ وَمَا هِيَ إِلَّا ذِكۡرَىٰ لِلۡبَشَرِ","juz":29,"page":576},{"n":32,"text":"كَلَّا وَٱلۡقَمَرِ","juz":29,"page":576},{"n":33,"text":"وَٱلَّيۡلِ إِذۡ أَدۡبَرَ","juz":29,"page":576},{"n":34,"text":"وَٱلصُّبۡحِ إِذَآ أَسۡفَرَ","juz":29,"page":576},{"n":35,"text":"إِنَّهَا لَإِحۡدَى ٱلۡكُبَرِ","juz":29,"page":576},{"n":36,"text":"نَذِيرࣰ ا لِّلۡبَشَرِ","juz":29,"page":576},{"n":37,"text":"لِمَن شَآءَ مِنكُمۡ أَن يَتَقَدَّمَ أَوۡ يَتَأَخَّرَ","juz":29,"page":576},{"n":38,"text":"كُلُّ نَفۡسِۭ بِمَا كَسَبَتۡ رَهِينَةٌ","juz":29,"page":576},{"n":39,"text":"إِلَّآ أَصۡحَٰبَ ٱلۡيَمِينِ","juz":29,"page":576},{"n":40,"text":"فِي جَنَّٰتࣲ يَتَسَآءَلُونَ","juz":29,"page":576},{"n":41,"text":"عَنِ ٱلۡمُجۡرِمِينَ","juz":29,"page":576},{"n":42,"text":"مَا سَلَكَكُمۡ فِي سَقَرَ","juz":29,"page":576},{"n":43,"text":"قَالُواْ لَمۡ نَكُ مِنَ ٱلۡمُصَلِّينَ","juz":29,"page":576},{"n":44,"text":"وَلَمۡ نَكُ نُطۡعِمُ ٱلۡمِسۡكِينَ","juz":29,"page":576},{"n":45,"text":"وَكُنَّا نَخُوضُ مَعَ ٱلۡخَآئِضِينَ","juz":29,"page":576},{"n":46,"text":"وَكُنَّا نُكَذِّبُ بِيَوۡمِ ٱلدِّينِ","juz":29,"page":576},{"n":47,"text":"حَتَّىٰٓ أَتَىٰنَا ٱلۡيَقِينُ","juz":29,"page":576},{"n":48,"text":"فَمَا تَنفَعُهُمۡ شَفَٰعَةُ ٱلشَّٰفِعِينَ","juz":29,"page":577},{"n":49,"text":"فَمَا لَهُمۡ عَنِ ٱلتَّذۡكِرَةِ مُعۡرِضِينَ","juz":29,"page":577},{"n":50,"text":"كَأَنَّهُمۡ حُمُرࣱ مُّسۡتَنفِرَةࣱ‏","juz":29,"page":577},{"n":51,"text":"فَرَّتۡ مِن قَسۡوَرَةِۭ","juz":29,"page":577},{"n":52,"text":"بَلۡ يُرِيدُ كُلُّ ٱمۡرِيࣲٕ مِّنۡهُمۡ أَن يُؤۡتَىٰ صُحُفࣰ ا مُّنَشَّرَةࣰ‏","juz":29,"page":577},{"n":53,"text":"كَلَّاۖ بَل لَّا يَخَافُونَ ٱلۡأٓخِرَةَ","juz":29,"page":577},{"n":54,"text":"كَلَّآ إِنَّهُۥ تَذۡكِرَةࣱ‏","juz":29,"page":577},{"n":55,"text":"فَمَن شَآءَ ذَكَرَهُۥ","juz":29,"page":577},{"n":56,"text":"وَمَا يَذۡكُرُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُۚ هُوَ أَهۡلُ ٱلتَّقۡوَىٰ وَأَهۡلُ ٱلۡمَغۡفِرَةِ","juz":29,"page":577}]}