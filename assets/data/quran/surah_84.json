{"number":84,"name":"الاِنْشِقَاقِ","ayahs":[{"n":1,"text":"إِذَا ٱلسَّمَآءُ ٱنشَقَّتۡ","juz":30,"page":589},{"n":2,"text":"وَأَذِنَتۡ لِرَبِّهَا وَحُقَّتۡ","juz":30,"page":589},{"n":3,"text":"وَإِذَا ٱلۡأَرۡضُ مُدَّتۡ","juz":30,"page":589},{"n":4,"text":"وَأَلۡقَتۡ مَا فِيهَا وَتَخَلَّتۡ","juz":30,"page":589},{"n":5,"text":"وَأَذِنَتۡ لِرَبِّهَا وَحُقَّتۡ","juz":30,"page":589},{"n":6,"text":"يَٰٓأَيُّهَا ٱلۡإِنسَٰنُ إِنَّكَ كَادِحٌ إِلَىٰ رَبِّكَ كَدۡحࣰ ا فَمُلَٰقِيهِ","juz":30,"page":589},{"n":7,"text":"فَأَمَّا مَنۡ أُوتِيَ كِتَٰبَهُۥ بِيَمِينِهِۦ","juz":30,"page":589},{"n":8,"text":"فَسَوۡفَ يُحَاسَبُ حِسَابࣰ ا يَسِيرࣰ ا","juz":30,"page":589},{"n":9,"text":"وَيَنقَلِبُ إِلَىٰٓ أَهۡلِهِۦ مَسۡرُورࣰ ا","juz":30,"page":589},{"n":10,"text":"وَأَمَّا مَنۡ أُوتِيَ كِتَٰبَهُۥ وَرَآءَ ظَهۡرِهِۦ","juz":30,"page":589},{"n":11,"text":"فَسَوۡفَ يَدۡعُواْ ثُبُورࣰ ا","juz":30,"page":589},{"n":12,"text":"وَيَصۡلَىٰ سَعِيرًا","juz":30,"page":589},{"n":13,"text":"إِنَّهُۥ كَانَ فِيٓ أَهۡلِهِۦ مَسۡرُورًا","juz":30,"page":589},{"n":14,"text":"إِنَّهُۥ ظَنَّ أَن لَّن يَحُورَ","juz":30,"page":589},{"n":15,"text":"بَلَىٰٓۚ إِنَّ رَبَّهُۥ كَانَ بِهِۦ بَصِيرࣰ ا","juz":30,"page":589},{"n":16,"text":"فَلَآ أُقۡسِمُ بِٱلشَّفَقِ","juz":30,"page":589},{"n":17,"text":"وَٱلَّيۡلِ وَمَا وَسَقَ","juz":30,"page":589},{"n":18,"text":"وَٱلۡقَمَرِ إِذَا ٱتَّسَقَ","juz":30,"page":589},{"n":19,"text":"لَتَرۡكَبُنَّ طَبَقًا عَن طَبَقࣲ‏","juz":30,"page":589},{"n":20,"text":"فَمَا لَهُمۡ لَا يُؤۡمِنُونَ","juz":30,"page":589},{"n":21,"text":"وَإِذَا قُرِئَ عَلَيۡهِمُ ٱلۡقُرۡءَانُ لَا يَسۡجُدُونَۤ۩","juz":30,"page":589,"sajda":true},{"n":22,"text":"بَلِ ٱلَّذِينَ كَفَرُواْ يُكَذِّبُونَ","juz":30,"page":589},{"n":23,"text":"وَٱللَّهُ أَعۡلَمُ بِمَا يُوعُونَ","juz":30,"page":589},{"n":24,"text":"فَبَشِّرۡهُم بِعَذَابٍ أَلِيمٍ","juz":30,"page":589},{"n":25,"text":"إِلَّا ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ لَهُمۡ أَجۡرٌ غَيۡرُ مَمۡنُونِۭ","juz":30,"page":589}]}