{"number":113,"name":"الْفَلَقِ","ayahs":[{"n":1,"text":"قُلۡ أَعُوذُ بِرَبِّ ٱلۡفَلَقِ","juz":30,"page":604},{"n":2,"text":"مِن شَرِّ مَا خَلَقَ","juz":30,"page":604},{"n":3,"text":"وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ","juz":30,"page":604},{"n":4,"text":"وَمِن شَرِّ ٱلنَّفَّٰثَٰتِ فِي ٱلۡعُقَدِ","juz":30,"page":604},{"n":5,"text":"وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ","juz":30,"page":604}]}