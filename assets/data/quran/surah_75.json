{"number":75,"name":"الْقِيَامَةِ","ayahs":[{"n":1,"text":"لَآ أُقۡسِمُ بِيَوۡمِ ٱلۡقِيَٰمَةِ","juz":29,"page":577},{"n":2,"text":"وَلَآ أُقۡسِمُ بِٱلنَّفۡسِ ٱللَّوَّامَةِ","juz":29,"page":577},{"n":3,"text":"أَيَحۡسَبُ ٱلۡإِنسَٰنُ أَلَّن نَّجۡمَعَ عِظَامَهُۥ","juz":29,"page":577},{"n":4,"text":"بَلَىٰ قَٰدِرِينَ عَلَىٰٓ أَن نُّسَوِّيَ بَنَانَهُۥ","juz":29,"page":577},{"n":5,"text":"بَلۡ يُرِيدُ ٱلۡإِنسَٰنُ لِيَفۡجُرَ أَمَامَهُۥ","juz":29,"page":577},{"n":6,"text":"يَسۡـَٔلُ أَيَّانَ يَوۡمُ ٱلۡقِيَٰمَةِ","juz":29,"page":577},{"n":7,"text":"فَإِذَا بَرِقَ ٱلۡبَصَرُ","juz":29,"page":577},{"n":8,"text":"وَخَسَفَ ٱلۡقَمَرُ","juz":29,"page":577},{"n":9,"text":"وَجُمِعَ ٱلشَّمۡسُ وَٱلۡقَمَرُ","juz":29,"page":577},{"n":10,"text":"يَقُولُ ٱلۡإِنسَٰنُ يَوۡمَئِذٍ أَيۡنَ ٱلۡمَفَرُّ","juz":29,"page":577},{"n":11,"text":"كَلَّا لَا وَزَرَ","juz":29,"page":577},{"n":12,"text":"إِلَىٰ رَبِّكَ يَوۡمَئِذٍ ٱلۡمُسۡتَقَرُّ","juz":29,"page":577},{"n":13,"text":"يُنَبَّؤُاْ ٱلۡإِنسَٰنُ يَوۡمَئِذِۭ بِمَا قَدَّمَ وَأَخَّرَ","juz":29,"page":577},{"n":14,"text":"بَلِ ٱلۡإِنسَٰنُ عَلَىٰ نَفۡسِهِۦ بَصِيرَةࣱ‏","juz":29,"page":577},{"n":15,"text":"وَلَوۡ أَلۡقَىٰ مَعَاذِيرَهُۥ","juz":29,"page":577},{"n":16,"text":"لَا تُحَرِّكۡ بِهِۦ لِسَانَكَ لِتَعۡجَلَ بِهِۦٓ","juz":29,"page":577},{"n":17,"text":"إِنَّ عَلَيۡنَا جَمۡعَهُۥ وَقُرۡءَانَهُۥ","juz":29,"page":577},{"n":18,"text":"فَإِذَا قَرَأۡنَٰهُ فَٱتَّبِعۡ قُرۡءَانَهُۥ","juz":29,"page":577},{"n":19,"text":"ثُمَّ إِنَّ عَلَيۡنَا بَيَانَهُۥ","juz":29,"page":577},{"n":20,"text":"كَلَّا بَلۡ تُحِبُّونَ ٱلۡعَاجِلَةَ","juz":29,"page":578},{"n":21,"text":"وَتَذَرُونَ ٱلۡأٓخِرَةَ","juz":29,"page":578},{"n":22,"text":"وُجُوهࣱ يَوۡمَئِذࣲ نَّاضِرَةٌ","juz":29,"page":578},{"n":23,"text":"إِلَىٰ رَبِّهَا نَاظِرَةࣱ‏","juz":29,"page":578},{"n":24,"text":"وَوُجُوهࣱ يَوۡمَئِذِۭ بَاسِرَةࣱ‏","juz":29,"page":578},{"n":25,"text":"تَظُنُّ أَن يُفۡعَلَ بِهَا فَاقِرَةࣱ‏","juz":29,"page":578},{"n":26,"text":"كَلَّآ إِذَا بَلَغَتِ ٱلتَّرَاقِيَ","juz":29,"page":578},{"n":27,"text":"وَقِيلَ مَنۡۜ رَاقࣲ‏","juz":29,"page":578},{"n":28,"text":"وَظَنَّ أَنَّهُ ٱلۡفِرَاقُ","juz":29,"page":578},{"n":29,"text":"وَٱلۡتَفَّتِ ٱلسَّاقُ بِٱلسَّاقِ","juz":29,"page":578},{"n":30,"text":"إِلَىٰ رَبِّكَ يَوۡمَئِذٍ ٱلۡمَسَاقُ","juz":29,"page":578},{"n":31,"text":"فَلَا صَدَّقَ وَلَا صَلَّىٰ","juz":29,"page":578},{"n":32,"text":"وَلَٰكِن كَذَّبَ وَتَوَلَّىٰ","juz":29,"page":578},{"n":33,"text":"ثُمَّ ذَهَبَ إِلَىٰٓ أَهۡلِهِۦ يَتَمَطَّىٰٓ","juz":29,"page":578},{"n":34,"text":"أَوۡلَىٰ لَكَ فَأَوۡلَىٰ","juz":29,"page":578},{"n":35,"text":"ثُمَّ أَوۡلَىٰ لَكَ فَأَوۡلَىٰٓ","juz":29,"page":578},{"n":36,"text":"أَيَحۡسَبُ ٱلۡإِنسَٰنُ أَن يُتۡرَكَ سُدًى","juz":29,"page":578},{"n":37,"text":"أَلَمۡ يَكُ نُطۡفَةࣰ مِّن مَّنِيࣲّ يُمۡنَىٰ","juz":29,"page":578},{"n":38,"text":"ثُمَّ كَانَ عَلَقَةࣰ فَخَلَقَ فَسَوَّىٰ","juz":29,"page":578},{"n":39,"text":"فَجَعَلَ مِنۡهُ ٱلزَّوۡجَيۡنِ ٱلذَّكَرَ وَٱلۡأُنثَىٰٓ","juz":29,"page":578},{"n":40,"text":"أَلَيۡسَ ذَٰلِكَ بِقَٰدِرٍ عَلَىٰٓ أَن يُحۡـِۧيَ ٱلۡمَوۡتَىٰ","juz":29,"page":578}]}