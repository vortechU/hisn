{"number":95,"name":"التِّيْنِ","ayahs":[{"n":1,"text":"وَٱلتِّينِ وَٱلزَّيۡتُونِ","juz":30,"page":597},{"n":2,"text":"وَطُورِ سِينِينَ","juz":30,"page":597},{"n":3,"text":"وَهَٰذَا ٱلۡبَلَدِ ٱلۡأَمِينِ","juz":30,"page":597},{"n":4,"text":"لَقَدۡ خَلَقۡنَا ٱلۡإِنسَٰنَ فِيٓ أَحۡسَنِ تَقۡوِيمࣲ‏","juz":30,"page":597},{"n":5,"text":"ثُمَّ رَدَدۡنَٰهُ أَسۡفَلَ سَٰفِلِينَ","juz":30,"page":597},{"n":6,"text":"إِلَّا ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ فَلَهُمۡ أَجۡرٌ غَيۡرُ مَمۡنُونࣲ‏","juz":30,"page":597},{"n":7,"text":"فَمَا يُكَذِّبُكَ بَعۡدُ بِٱلدِّينِ","juz":30,"page":597},{"n":8,"text":"أَلَيۡسَ ٱللَّهُ بِأَحۡكَمِ ٱلۡحَٰكِمِينَ","juz":30,"page":597}]}