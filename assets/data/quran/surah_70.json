{"number":70,"name":"الْمَعَارِجِ","ayahs":[{"n":1,"text":"سَأَلَ سَآئِلُۢ بِعَذَابࣲ وَاقِعࣲ‏","juz":29,"page":568},{"n":2,"text":"لِّلۡكَٰفِرِينَ لَيۡسَ لَهُۥ دَافِعࣱ‏","juz":29,"page":568},{"n":3,"text":"مِّنَ ٱللَّهِ ذِي ٱلۡمَعَارِجِ","juz":29,"page":568},{"n":4,"text":"تَعۡرُجُ ٱلۡمَلَٰٓئِكَةُ وَٱلرُّوحُ إِلَيۡهِ فِي يَوۡمࣲ كَانَ مِقۡدَارُهُۥ خَمۡسِينَ أَلۡفَ سَنَةࣲ‏","juz":29,"page":568},{"n":5,"text":"فَٱصۡبِرۡ صَبۡرࣰا جَمِيلًا","juz":29,"page":568},{"n":6,"text":"إِنَّهُمۡ يَرَوۡنَهُۥ بَعِيدࣰا","juz":29,"page":568},{"n":7,"text":"وَنَرَىٰهُ قَرِيبࣰا","juz":29,"page":568},{"n":8,"text":"يَوۡمَ تَكُونُ ٱلسَّمَآءُ كَٱلۡمُهۡلِ","juz":29,"page":568},{"n":9,"text":"وَتَكُونُ ٱلۡجِبَالُ كَٱلۡعِهۡنِ","juz":29,"page":568},{"n":10,"text":"وَلَا يَسۡـَٔلُ حَمِيمٌ حَمِيمࣰا","juz":29,"page":568},{"n":11,"text":"يُبَصَّرُونَهُمۡۚ يَوَدُّ ٱلۡمُجۡرِمُ لَوۡ يَفۡتَدِي مِنۡ عَذَابِ يَوۡمِئِذِۭ بِبَنِيهِ","juz":29,"page":569},{"n":12,"text":"وَصَٰحِبَتِهِۦ وَأَخِيهِ","juz":29,"page":569},{"n":13,"text":"وَفَصِيلَتِهِ ٱلَّتِي تُـٔۡوِيهِ","juz":29,"page":569},{"n":14,"text":"وَمَن فِي ٱلۡأَرۡضِ جَمِيعࣰا ثُمَّ يُنجِيهِ","juz":29,"page":569},{"n":15,"text":"كَلَّآۖ إِنَّهَا لَظَىٰ","juz":29,"page":569},{"n":16,"text":"نَزَّاعَةࣰ لِّلشَّوَىٰ","juz":29,"page":569},{"n":17,"text":"تَدۡعُواْ مَنۡ أَدۡبَرَ وَتَوَلَّىٰ","juz":29,"page":569},{"n":18,"text":"وَجَمَعَ فَأَوۡعَىٰٓ","juz":29,"page":569},{"n":19,"text":"۞إِنَّ ٱلۡإِنسَٰنَ خُلِقَ هَلُوعًا","juz":29,"page":569},{"n":20,"text":"إِذَا مَسَّهُ ٱلشَّرُّ جَزُوعࣰا","juz":29,"page":569},{"n":21,"text":"وَإِذَا مَسَّهُ ٱلۡخَيۡرُ مَنُوعًا","juz":29,"page":569},{"n":22,"text":"إِلَّا ٱلۡمُصَلِّينَ","juz":29,"page":569},{"n":23,"text":"ٱلَّذِينَ هُمۡ عَلَىٰ صَلَاتِهِمۡ دَآئِمُونَ","juz":29,"page":569},{"n":24,"text":"وَٱلَّذِينَ فِيٓ أَمۡوَٰلِهِمۡ حَقࣱّ مَّعۡلُومࣱ‏","juz":29,"page":569},{"n":25,"text":"لِّلسَّآئِلِ وَٱلۡمَحۡرُومِ","juz":29,"page":569},{"n":26,"text":"وَٱلَّذِينَ يُصَدِّقُونَ بِيَوۡمِ ٱلدِّينِ","juz":29,"page":569},{"n":27,"text":"وَٱلَّذِينَ هُم مِّنۡ عَذَابِ رَبِّهِم مُّشۡفِقُونَ","juz":29,"page":569},{"n":28,"text":"إِنَّ عَذَابَ رَبِّهِمۡ غَيۡرُ مَأۡمُونࣲ‏","juz":29,"page":569},{"n":29,"text":"وَٱلَّذِينَ هُمۡ لِفُرُوجِهِمۡ حَٰفِظُونَ","juz":29,"page":569},{"n":30,"text":"إِلَّا عَلَىٰٓ أَزۡوَٰجِهِمۡ أَوۡ مَا مَلَكَتۡ أَيۡمَٰنُهُمۡ فَإِنَّهُمۡ غَيۡرُ مَلُومِينَ","juz":29,"page":569},{"n":31,"text":"فَمَنِ ٱبۡتَغَىٰ وَرَآءَ ذَٰلِكَ فَأُوْلَٰٓئِكَ هُمُ ٱلۡعَادُونَ","juz":29,"page":569},{"n":32,"text":"وَٱلَّذِينَ هُمۡ لِأَمَٰنَٰتِهِمۡ وَعَهۡدِهِمۡ رَٰعُونَ","juz":29,"page":569},{"n":33,"text":"وَٱلَّذِينَ هُم بِشَهَٰدَٰتِهِمۡ قَآئِمُونَ","juz":29,"page":569},{"n":34,"text":"وَٱلَّذِينَ هُمۡ عَلَىٰ صَلَاتِهِمۡ يُحَافِظُونَ","juz":29,"page":569},{"n":35,"text":"أُوْلَٰٓئِكَ فِي جَنَّٰتࣲ مُّكۡرَمُونَ","juz":29,"page":569},{"n":36,"text":"فَمَالِ ٱلَّذِينَ كَفَرُواْ قِبَلَكَ مُهۡطِعِينَ","juz":29,"page":569},{"n":37,"text":"عَنِ ٱلۡيَمِينِ وَعَنِ ٱلشِّمَالِ عِزِينَ","juz":29,"page":569},{"n":38,"text":"أَيَطۡمَعُ كُلُّ ٱمۡرِيࣲٕ مِّنۡهُمۡ أَن يُدۡخَلَ جَنَّةَ نَعِيمࣲ‏","juz":29,"page":569},{"n":39,"text":"كَلَّآۖ إِنَّا خَلَقۡنَٰهُم مِّمَّا يَعۡلَمُونَ","juz":29,"page":569},{"n":40,"text":"فَلَآ أُقۡسِمُ بِرَبِّ ٱلۡمَشَٰرِقِ وَٱلۡمَغَٰرِبِ إِنَّا لَقَٰدِرُونَ","juz":29,"page":570},{"n":41,"text":"عَلَىٰٓ أَن نُّبَدِّلَ خَيۡرࣰا مِّنۡهُمۡ وَمَا نَحۡنُ بِمَسۡبُوقِينَ","juz":29,"page":570},{"n":42,"text":"فَذَرۡهُمۡ يَخُوضُواْ وَيَلۡعَبُواْ حَتَّىٰ يُلَٰقُواْ يَوۡمَهُمُ ٱلَّذِي يُوعَدُونَ","juz":29,"page":570},{"n":43,"text":"يَوۡمَ يَخۡرُجُونَ مِنَ ٱلۡأَجۡدَاثِ سِرَاعࣰا كَأَنَّهُمۡ إِلَىٰ نُصُبࣲ يُوفِضُونَ","juz":29,"page":570},{"n":44,"text":"خَٰشِعَةً أَبۡصَٰرُهُمۡ تَرۡهَقُهُمۡ ذِلَّةࣱۚ ذَٰلِكَ ٱلۡيَوۡمُ ٱلَّذِي كَانُواْ يُوعَدُونَ","juz":29,"page":570}]}