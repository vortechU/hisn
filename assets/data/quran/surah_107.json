{"number":107,"name":"الْمَاعُوْنِ","ayahs":[{"n":1,"text":"أَرَءَيۡتَ ٱلَّذِي يُكَذِّبُ بِٱلدِّينِ","juz":30,"page":602},{"n":2,"text":"فَذَٰلِكَ ٱلَّذِي يَدُعُّ ٱلۡيَتِيمَ","juz":30,"page":602},{"n":3,"text":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلۡمِسۡكِينِ","juz":30,"page":602},{"n":4,"text":"فَوَيۡلࣱ لِّلۡمُصَلِّينَ","juz":30,"page":602},{"n":5,"text":"ٱلَّذِينَ هُمۡ عَن صَلَاتِهِمۡ سَاهُونَ","juz":30,"page":602},{"n":6,"text":"ٱلَّذِينَ هُمۡ يُرَآءُونَ","juz":30,"page":602},{"n":7,"text":"وَيَمۡنَعُونَ ٱلۡمَاعُونَ","juz":30,"page":602}]}