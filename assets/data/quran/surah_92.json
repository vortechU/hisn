{"number":92,"name":"الَّيْلِ","ayahs":[{"n":1,"text":"وَٱلَّيۡلِ إِذَا يَغۡشَىٰ","juz":30,"page":595},{"n":2,"text":"وَٱلنَّهَارِ إِذَا تَجَلَّىٰ","juz":30,"page":595},{"n":3,"text":"وَمَا خَلَقَ ٱلذَّكَرَ وَٱلۡأُنثَىٰٓ","juz":30,"page":595},{"n":4,"text":"إِنَّ سَعۡيَكُمۡ لَشَتَّىٰ","juz":30,"page":595},{"n":5,"text":"فَأَمَّا مَنۡ أَعۡطَىٰ وَٱتَّقَىٰ","juz":30,"page":595},{"n":6,"text":"وَصَدَّقَ بِٱلۡحُسۡنَىٰ","juz":30,"page":595},{"n":7,"text":"فَسَنُيَسِّرُهُۥ لِلۡيُسۡرَىٰ","juz":30,"page":595},{"n":8,"text":"وَأَمَّا مَنۢ بَخِلَ وَٱسۡتَغۡنَىٰ","juz":30,"page":595},{"n":9,"text":"وَكَذَّبَ بِٱلۡحُسۡنَىٰ","juz":30,"page":595},{"n":10,"text":"فَسَنُيَسِّرُهُۥ لِلۡعُسۡرَىٰ","juz":30,"page":595},{"n":11,"text":"وَمَا يُغۡنِي عَنۡهُ مَالُهُۥٓ إِذَا تَرَدَّىٰٓ","juz":30,"page":595},{"n":12,"text":"إِنَّ عَلَيۡنَا لَلۡهُدَىٰ","juz":30,"page":595},{"n":13,"text":"وَإِنَّ لَنَا لَلۡأٓخِرَةَ وَٱلۡأُولَىٰ","juz":30,"page":595},{"n":14,"text":"فَأَنذَرۡتُكُمۡ نَارࣰا تَلَظَّىٰ","juz":30,"page":595},{"n":15,"text":"لَا يَصۡلَىٰهَآ إِلَّا ٱلۡأَشۡقَى","juz":30,"page":596},{"n":16,"text":"ٱلَّذِي كَذَّبَ وَتَوَلَّىٰ","juz":30,"page":596},{"n":17,"text":"وَسَيُجَنَّبُهَا ٱلۡأَتۡقَى","juz":30,"page":596},{"n":18,"text":"ٱلَّذِي يُؤۡتِي مَالَهُۥ يَتَزَكَّىٰ","juz":30,"page":596},{"n":19,"text":"وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعۡمَةࣲ تُجۡزَىٰٓ","juz":30,"page":596},{"n":20,"text":"إِلَّا ٱبۡتِغَآءَ وَجۡهِ رَبِّهِ ٱلۡأَعۡلَىٰ","juz":30,"page":596},{"n":21,"text":"وَلَسَوۡفَ يَرۡضَىٰ","juz":30,"page":596}]}