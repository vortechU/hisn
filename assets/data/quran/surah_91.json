{"number":91,"name":"الشَّمْسِ","ayahs":[{"n":1,"text":"وَٱلشَّمۡسِ وَضُحَىٰهَا","juz":30,"page":595},{"n":2,"text":"وَٱلۡقَمَرِ إِذَا تَلَىٰهَا","juz":30,"page":595},{"n":3,"text":"وَٱلنَّهَارِ إِذَا جَلَّىٰهَا","juz":30,"page":595},{"n":4,"text":"وَٱلَّيۡلِ إِذَا يَغۡشَىٰهَا","juz":30,"page":595},{"n":5,"text":"وَٱلسَّمَآءِ وَمَا بَنَىٰهَا","juz":30,"page":595},{"n":6,"text":"وَٱلۡأَرۡضِ وَمَا طَحَىٰهَا","juz":30,"page":595},{"n":7,"text":"وَنَفۡسࣲ وَمَا سَوَّىٰهَا","juz":30,"page":595},{"n":8,"text":"فَأَلۡهَمَهَا فُجُورَهَا وَتَقۡوَىٰهَا","juz":30,"page":595},{"n":9,"text":"قَدۡ أَفۡلَحَ مَن زَكَّىٰهَا","juz":30,"page":595},{"n":10,"text":"وَقَدۡ خَابَ مَن دَسَّىٰهَا","juz":30,"page":595},{"n":11,"text":"كَذَّبَتۡ ثَمُودُ بِطَغۡوَىٰهَآ","juz":30,"page":595},{"n":12,"text":"إِذِ ٱنۢبَعَثَ أَشۡقَىٰهَا","juz":30,"page":595},{"n":13,"text":"فَقَالَ لَهُمۡ رَسُولُ ٱللَّهِ نَاقَةَ ٱللَّهِ وَسُقۡيَٰهَا","juz":30,"page":595},{"n":14,"text":"فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمۡدَمَ عَلَيۡهِمۡ رَبُّهُم بِذَنۢبِهِمۡ فَسَوَّىٰهَا","juz":30,"page":595},{"n":15,"text":"وَلَا يَخَافُ عُقۡبَٰهَا","juz":30,"page":595}]}