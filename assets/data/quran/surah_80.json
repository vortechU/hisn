{"number":80,"name":"عَبَسَ","ayahs":[{"n":1,"text":"عَبَسَ وَتَوَلَّىٰٓ","juz":30,"page":585},{"n":2,"text":"أَن جَآءَهُ ٱلۡأَعۡمَىٰ","juz":30,"page":585},{"n":3,"text":"وَمَا يُدۡرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ","juz":30,"page":585},{"n":4,"text":"أَوۡ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكۡرَىٰٓ","juz":30,"page":585},{"n":5,"text":"أَمَّا مَنِ ٱسۡتَغۡنَىٰ","juz":30,"page":585},{"n":6,"text":"فَأَنتَ لَهُۥ تَصَدَّىٰ","juz":30,"page":585},{"n":7,"text":"وَمَا عَلَيۡكَ أَلَّا يَزَّكَّىٰ","juz":30,"page":585},{"n":8,"text":"وَأَمَّا مَن جَآءَكَ يَسۡعَىٰ","juz":30,"page":585},{"n":9,"text":"وَهُوَ يَخۡشَىٰ","juz":30,"page":585},{"n":10,"text":"فَأَنتَ عَنۡهُ تَلَهَّىٰ","juz":30,"page":585},{"n":11,"text":"كَلَّآ إِنَّهَا تَذۡكِرَةࣱ‏","juz":30,"page":585},{"n":12,"text":"فَمَن شَآءَ ذَكَرَهُۥ","juz":30,"page":585},{"n":13,"text":"فِي صُحُفࣲ مُّكَرَّمَةࣲ‏","juz":30,"page":585},{"n":14,"text":"مَّرۡفُوعَةࣲ مُّطَهَّرَةِۭ","juz":30,"page":585},{"n":15,"text":"بِأَيۡدِي سَفَرَةࣲ‏","juz":30,"page":585},{"n":16,"text":"كِرَامِۭ بَرَرَةࣲ‏","juz":30,"page":585},{"n":17,"text":"قُتِلَ ٱلۡإِنسَٰنُ مَآ أَكۡفَرَهُۥ","juz":30,"page":585},{"n":18,"text":"مِنۡ أَيِّ شَيۡءٍ خَلَقَهُۥ","juz":30,"page":585},{"n":19,"text":"مِن نُّطۡفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ","juz":30,"page":585},{"n":20,"text":"ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ","juz":30,"page":585},{"n":21,"text":"ثُمَّ أَمَاتَهُۥ فَأَقۡبَرَهُۥ","juz":30,"page":585},{"n":22,"text":"ثُمَّ إِذَا شَآءَ أَنشَرَهُۥ","juz":30,"page":585},{"n":23,"text":"كَلَّا لَمَّا يَقۡضِ مَآ أَمَرَهُۥ","juz":30,"page":585},{"n":24,"text":"فَلۡيَنظُرِ ٱلۡإِنسَٰنُ إِلَىٰ طَعَامِهِۦٓ","juz":30,"page":585},{"n":25,"text":"أَنَّا صَبَبۡنَا ٱلۡمَآءَ صَبࣰّ ا","juz":30,"page":585},{"n":26,"text":"ثُمَّ شَقَقۡنَا ٱلۡأَرۡضَ شَقࣰّ ا","juz":30,"page":585},{"n":27,"text":"فَأَنۢبَتۡنَا فِيهَا حَبࣰّ ا","juz":30,"page":585},{"n":28,"text":"وَعِنَبࣰ ا وَقَضۡبࣰ ا","juz":30,"page":585},{"n":29,"text":"وَزَيۡتُونࣰ ا وَنَخۡلࣰ ا","juz":30,"page":585},{"n":30,"text":"وَحَدَآئِقَ غُلۡبࣰ ا","juz":30,"page":585},{"n":31,"text":"وَفَٰكِهَةࣰ وَأَبࣰّ ا","juz":30,"page":585},{"n":32,"text":"مَّتَٰعࣰ ا لَّكُمۡ وَلِأَنۡعَٰمِكُمۡ","juz":30,"page":585},{"n":33,"text":"فَإِذَا جَآءَتِ ٱلصَّآخَّةُ","juz":30,"page":585},{"n":34,"text":"يَوۡمَ يَفِرُّ ٱلۡمَرۡءُ مِنۡ أَخِيهِ","juz":30,"page":585},{"n":35,"text":"وَأُمِّهِۦ وَأَبِيهِ","juz":30,"page":585},{"n":36,"text":"وَصَٰحِبَتِهِۦ وَبَنِيهِ","juz":30,"page":585},{"n":37,"text":"لِكُلِّ ٱمۡرِيࣲٕ مِّنۡهُمۡ يَوۡمَئِذࣲ شَأۡنࣱ يُغۡنِيهِ","juz":30,"page":585},{"n":38,"text":"وُجُوهࣱ يَوۡمَئِذࣲ مُّسۡفِرَةࣱ‏","juz":30,"page":585},{"n":39,"text":"ضَاحِكَةࣱ مُّسۡتَبۡشِرَةࣱ‏","juz":30,"page":585},{"n":40,"text":"وَوُجُوهࣱ يَوۡمَئِذٍ عَلَيۡهَا غَبَرَةࣱ‏","juz":30,"page":585},{"n":41,"text":"تَرۡهَقُهَا قَتَرَةٌ","juz":30,"page":585},{"n":42,"text":"أُوْلَٰٓئِكَ هُمُ ٱلۡكَفَرَةُ ٱلۡفَجَرَةُ","juz":30,"page":585}]}