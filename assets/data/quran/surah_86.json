{"number":86,"name":"الطَّارِقِ","ayahs":[{"n":1,"text":"وَٱلسَّمَآءِ وَٱلطَّارِقِ","juz":30,"page":591},{"n":2,"text":"وَمَآ أَدۡرَىٰكَ مَا ٱلطَّارِقُ","juz":30,"page":591},{"n":3,"text":"ٱلنَّجۡمُ ٱلثَّاقِبُ","juz":30,"page":591},{"n":4,"text":"إِن كُلُّ نَفۡسࣲ لَّمَّا عَلَيۡهَا حَافِظࣱ‏","juz":30,"page":591},{"n":5,"text":"فَلۡيَنظُرِ ٱلۡإِنسَٰنُ مِمَّ خُلِقَ","juz":30,"page":591},{"n":6,"text":"خُلِقَ مِن مَّآءࣲ دَافِقࣲ‏","juz":30,"page":591},{"n":7,"text":"يَخۡرُجُ مِنۢ بَيۡنِ ٱلصُّلۡبِ وَٱلتَّرَآئِبِ","juz":30,"page":591},{"n":8,"text":"إِنَّهُۥ عَلَىٰ رَجۡعِهِۦ لَقَادِرࣱ‏","juz":30,"page":591},{"n":9,"text":"يَوۡمَ تُبۡلَى ٱلسَّرَآئِرُ","juz":30,"page":591},{"n":10,"text":"فَمَا لَهُۥ مِن قُوَّةࣲ وَلَا نَاصِرࣲ‏","juz":30,"page":591},{"n":11,"text":"وَٱلسَّمَآءِ ذَاتِ ٱلرَّجۡعِ","juz":30,"page":591},{"n":12,"text":"وَٱلۡأَرۡضِ ذَاتِ ٱلصَّدۡعِ","juz":30,"page":591},{"n":13,"text":"إِنَّهُۥ لَقَوۡلࣱ فَصۡلࣱ‏","juz":30,"page":591},{"n":14,"text":"وَمَا هُوَ بِٱلۡهَزۡلِ","juz":30,"page":591},{"n":15,"text":"إِنَّهُمۡ يَكِيدُونَ كَيۡدࣰا","juz":30,"page":591},{"n":16,"text":"وَأَكِيدُ كَيۡدࣰا","juz":30,"page":591},{"n":17,"text":"فَمَهِّلِ ٱلۡكَٰفِرِينَ أَمۡهِلۡهُمۡ رُوَيۡدَۢا","juz":30,"page":591}]}