{"number":96,"name":"الْعَلَقِ","ayahs":[{"n":1,"text":"ٱقۡرَأۡ بِٱسۡمِ رَبِّكَ ٱلَّذِي خَلَقَ","juz":30,"page":597},{"n":2,"text":"خَلَقَ ٱلۡإِنسَٰنَ مِنۡ عَلَقٍ","juz":30,"page":597},{"n":3,"text":"ٱقۡرَأۡ وَرَبُّكَ ٱلۡأَكۡرَمُ","juz":30,"page":597},{"n":4,"text":"ٱلَّذِي عَلَّمَ بِٱلۡقَلَمِ","juz":30,"page":597},{"n":5,"text":"عَلَّمَ ٱلۡإِنسَٰنَ مَا لَمۡ يَعۡلَمۡ","juz":30,"page":597},{"n":6,"text":"كَلَّآ إِنَّ ٱلۡإِنسَٰنَ لَيَطۡغَىٰٓ","juz":30,"page":597},{"n":7,"text":"أَن رَّءَاهُ ٱسۡتَغۡنَىٰٓ","juz":30,"page":597},{"n":8,"text":"إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجۡعَىٰٓ","juz":30,"page":597},{"n":9,"text":"أَرَءَيۡتَ ٱلَّذِي يَنۡهَىٰ","juz":30,"page":597},{"n":10,"text":"عَبۡدًا إِذَا صَلَّىٰٓ","juz":30,"page":597},{"n":11,"text":"أَرَءَيۡتَ إِن كَانَ عَلَى ٱلۡهُدَىٰٓ","juz":30,"page":597},{"n":12,"text":"أَوۡ أَمَرَ بِٱلتَّقۡوَىٰٓ","juz":30,"page":597},{"n":13,"text":"أَرَءَيۡتَ إِن كَذَّبَ وَتَوَلَّىٰٓ","juz":30,"page":597},{"n":14,"text":"أَلَمۡ يَعۡلَم بِأَنَّ ٱللَّهَ يَرَىٰ","juz":30,"page":597},{"n":15,"text":"كَلَّا لَئِن لَّمۡ يَنتَهِ لَنَسۡفَعَۢا بِٱلنَّاصِيَةِ","juz":30,"page":597},{"n":16,"text":"نَاصِيَةࣲ كَٰذِبَةٍ خَاطِئَةࣲ‏","juz":30,"page":597},{"n":17,"text":"فَلۡيَدۡعُ نَادِيَهُۥ","juz":30,"page":597},{"n":18,"text":"سَنَدۡعُ ٱلزَّبَانِيَةَ","juz":30,"page":597},{"n":19,"text":"كَلَّا لَا تُطِعۡهُ وَٱسۡجُدۡۤ وَٱقۡتَرِب۩","juz":30,"page":597,"sajda":true}]}