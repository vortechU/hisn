{"number":109,"name":"الْكَافِرُوْنَ","ayahs":[{"n":1,"text":"قُلۡ يَٰٓأَيُّهَا ٱلۡكَٰفِرُونَ","juz":30,"page":603},{"n":2,"text":"لَآ أَعۡبُدُ مَا تَعۡبُدُونَ","juz":30,"page":603},{"n":3,"text":"وَلَآ أَنتُمۡ عَٰبِدُونَ مَآ أَعۡبُدُ","juz":30,"page":603},{"n":4,"text":"وَلَآ أَنَا۠ عَابِدࣱ مَّا عَبَدتُّمۡ","juz":30,"page":603},{"n":5,"text":"وَلَآ أَنتُمۡ عَٰبِدُونَ مَآ أَعۡبُدُ","juz":30,"page":603},{"n":6,"text":"لَكُمۡ دِينُكُمۡ وَلِيَ دِينِ","juz":30,"page":603}]}