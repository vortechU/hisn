{"number":82,"name":"الْاِنْفِطَارِ","ayahs":[{"n":1,"text":"إِذَا ٱلسَّمَآءُ ٱنفَطَرَتۡ","juz":30,"page":587},{"n":2,"text":"وَإِذَا ٱلۡكَوَاكِبُ ٱنتَثَرَتۡ","juz":30,"page":587},{"n":3,"text":"وَإِذَا ٱلۡبِحَارُ فُجِّرَتۡ","juz":30,"page":587},{"n":4,"text":"وَإِذَا ٱلۡقُبُورُ بُعۡثِرَتۡ","juz":30,"page":587},{"n":5,"text":"عَلِمَتۡ نَفۡسࣱ مَّا قَدَّمَتۡ وَأَخَّرَتۡ","juz":30,"page":587},{"n":6,"text":"يَٰٓأَيُّهَا ٱلۡإِنسَٰنُ مَا غَرَّكَ بِرَبِّكَ ٱلۡكَرِيمِ","juz":30,"page":587},{"n":7,"text":"ٱلَّذِي خَلَقَكَ فَسَوَّىٰكَ فَعَدَلَكَ","juz":30,"page":587},{"n":8,"text":"فِيٓ أَيِّ صُورَةࣲ مَّا شَآءَ رَكَّبَكَ","juz":30,"page":587},{"n":9,"text":"كَلَّا بَلۡ تُكَذِّبُونَ بِٱلدِّينِ","juz":30,"page":587},{"n":10,"text":"وَإِنَّ عَلَيۡكُمۡ لَحَٰفِظِينَ","juz":30,"page":587},{"n":11,"text":"كِرَامࣰا كَٰتِبِينَ","juz":30,"page":587},{"n":12,"text":"يَعۡلَمُونَ مَا تَفۡعَلُونَ","juz":30,"page":587},{"n":13,"text":"إِنَّ ٱلۡأَبۡرَارَ لَفِي نَعِيمࣲ‏","juz":30,"page":587},{"n":14,"text":"وَإِنَّ ٱلۡفُجَّارَ لَفِي جَحِيمࣲ‏","juz":30,"page":587},{"n":15,"text":"يَصۡلَوۡنَهَا يَوۡمَ ٱلدِّينِ","juz":30,"page":587},{"n":16,"text":"وَمَا هُمۡ عَنۡهَا بِغَآئِبِينَ","juz":30,"page":587},{"n":17,"text":"وَمَآ أَدۡرَىٰكَ مَا يَوۡمُ ٱلدِّينِ","juz":30,"page":587},{"n":18,"text":"ثُمَّ مَآ أَدۡرَىٰكَ مَا يَوۡمُ ٱلدِّينِ","juz":30,"page":587},{"n":19,"text":"يَوۡمَ لَا تَمۡلِكُ نَفۡسࣱ لِّنَفۡسࣲ شَيۡـࣰٔاۖ وَٱلۡأَمۡرُ يَوۡمَئِذࣲ لِّلَّهِ","juz":30,"page":587}]}