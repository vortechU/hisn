{"number":69,"name":"الْحَآقَّةِ","ayahs":[{"n":1,"text":"ٱلۡحَآقَّةُ","juz":29,"page":566},{"n":2,"text":"مَا ٱلۡحَآقَّةُ","juz":29,"page":566},{"n":3,"text":"وَمَآ أَدۡرَىٰكَ مَا ٱلۡحَآقَّةُ","juz":29,"page":566},{"n":4,"text":"كَذَّبَتۡ ثَمُودُ وَعَادُۢ بِٱلۡقَارِعَةِ","juz":29,"page":566},{"n":5,"text":"فَأَمَّا ثَمُودُ فَأُهۡلِكُواْ بِٱلطَّاغِيَةِ","juz":29,"page":566},{"n":6,"text":"وَأَمَّا عَادࣱ فَأُهۡلِكُواْ بِرِيحࣲ صَرۡصَرٍ عَاتِيَةࣲ‏","juz":29,"page":566},{"n":7,"text":"سَخَّرَهَا عَلَيۡهِمۡ سَبۡعَ لَيَالࣲ وَثَمَٰنِيَةَ أَيَّامٍ حُسُومࣰاۖ فَتَرَى ٱلۡقَوۡمَ فِيهَا صَرۡعَىٰ كَأَنَّهُمۡ أَعۡجَازُ نَخۡلٍ خَاوِيَةࣲ‏","juz":29,"page":566},{"n":8,"text":"فَهَلۡ تَرَىٰ لَهُم مِّنۢ بَاقِيَةࣲ‏","juz":29,"page":566},{"n":9,"text":"وَجَآءَ فِرۡعَوۡنُ وَمَن قَبۡلَهُۥ وَٱلۡمُؤۡتَفِكَٰتُ بِٱلۡخَاطِئَةِ","juz":29,"page":567},{"n":10,"text":"فَعَصَوۡاْ رَسُولَ رَبِّهِمۡ فَأَخَذَهُمۡ أَخۡذَةࣰ رَّابِيَةً","juz":29,"page":567},{"n":11,"text":"إِنَّا لَمَّا طَغَا ٱلۡمَآءُ حَمَلۡنَٰكُمۡ فِي ٱلۡجَارِيَةِ","juz":29,"page":567},{"n":12,"text":"لِنَجۡعَلَهَا لَكُمۡ تَذۡكِرَةࣰ وَتَعِيَهَآ أُذُنࣱ وَٰعِيَةࣱ‏","juz":29,"page":567},{"n":13,"text":"فَإِذَا نُفِخَ فِي ٱلصُّورِ نَفۡخَةࣱ وَٰحِدَةࣱ‏","juz":29,"page":567},{"n":14,"text":"وَحُمِلَتِ ٱلۡأَرۡضُ وَٱلۡجِبَالُ فَدُكَّتَا دَكَّةࣰ وَٰحِدَةࣰ‏","juz":29,"page":567},{"n":15,"text":"فَيَوۡمَئِذࣲ وَقَعَتِ ٱلۡوَاقِعَةُ","juz":29,"page":567},{"n":16,"text":"وَٱنشَقَّتِ ٱلسَّمَآءُ فَهِيَ يَوۡمَئِذࣲ وَاهِيَةࣱ‏","juz":29,"page":567},{"n":17,"text":"وَٱلۡمَلَكُ عَلَىٰٓ أَرۡجَآئِهَاۚ وَيَحۡمِلُ عَرۡشَ رَبِّكَ فَوۡقَهُمۡ يَوۡمَئِذࣲ ثَمَٰنِيَةࣱ‏","juz":29,"page":567},{"n":18,"text":"يَوۡمَئِذࣲ تُعۡرَضُونَ لَا تَخۡفَىٰ مِنكُمۡ خَافِيَةࣱ‏","juz":29,"page":567},{"n":19,"text":"فَأَمَّا مَنۡ أُوتِيَ كِتَٰبَهُۥ بِيَمِينِهِۦ فَيَقُولُ هَآؤُمُ ٱقۡرَءُواْ كِتَٰبِيَهۡ","juz":29,"page":567},{"n":20,"text":"إِنِّي ظَنَنتُ أَنِّي مُلَٰقٍ حِسَابِيَهۡ","juz":29,"page":567},{"n":21,"text":"فَهُوَ فِي عِيشَةࣲ رَّاضِيَةࣲ‏","juz":29,"page":567},{"n":22,"text":"فِي جَنَّةٍ عَالِيَةࣲ‏","juz":29,"page":567},{"n":23,"text":"قُطُوفُهَا دَانِيَةࣱ‏","juz":29,"page":567},{"n":24,"text":"كُلُواْ وَٱشۡرَبُواْ هَنِيٓـَٔۢا بِمَآ أَسۡلَفۡتُمۡ فِي ٱلۡأَيَّامِ ٱلۡخَالِيَةِ","juz":29,"page":567},{"n":25,"text":"وَأَمَّا مَنۡ أُوتِيَ كِتَٰبَهُۥ بِشِمَالِهِۦ فَيَقُولُ يَٰلَيۡتَنِي لَمۡ أُوتَ كِتَٰبِيَهۡ","juz":29,"page":567},{"n":26,"text":"وَلَمۡ أَدۡرِ مَا حِسَابِيَهۡ","juz":29,"page":567},{"n":27,"text":"يَٰلَيۡتَهَا كَانَتِ ٱلۡقَاضِيَةَ","juz":29,"page":567},{"n":28,"text":"مَآ أَغۡنَىٰ عَنِّي مَالِيَهۡۜ","juz":29,"page":567},{"n":29,"text":"هَلَكَ عَنِّي سُلۡطَٰنِيَهۡ","juz":29,"page":567},{"n":30,"text":"خُذُوهُ فَغُلُّوهُ","juz":29,"page":567},{"n":31,"text":"ثُمَّ ٱلۡجَحِيمَ صَلُّوهُ","juz":29,"page":567},{"n":32,"text":"ثُمَّ فِي سِلۡسِلَةࣲ ذَرۡعُهَا سَبۡعُونَ ذِرَاعࣰا فَٱسۡلُكُوهُ","juz":29,"page":567},{"n":33,"text":"إِنَّهُۥ كَانَ لَا يُؤۡمِنُ بِٱللَّهِ ٱلۡعَظِيمِ","juz":29,"page":567},{"n":34,"text":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلۡمِسۡكِينِ","juz":29,"page":567},{"n":35,"text":"فَلَيۡسَ لَهُ ٱلۡيَوۡمَ هَٰهُنَا حَمِيمࣱ‏","juz":29,"page":568},{"n":36,"text":"وَلَا طَعَامٌ إِلَّا مِنۡ غِسۡلِينࣲ‏","juz":29,"page":568},{"n":37,"text":"لَّا يَأۡكُلُهُۥٓ إِلَّا ٱلۡخَٰطِـُٔونَ","juz":29,"page":568},{"n":38,"text":"فَلَآ أُقۡسِمُ بِمَا تُبۡصِرُونَ","juz":29,"page":568},{"n":39,"text":"وَمَا لَا تُبۡصِرُونَ","juz":29,"page":568},{"n":40,"text":"إِنَّهُۥ لَقَوۡلُ رَسُولࣲ كَرِيمࣲ‏","juz":29,"page":568},{"n":41,"text":"وَمَا هُوَ بِقَوۡلِ شَاعِرࣲۚ قَلِيلࣰا مَّا تُؤۡمِنُونَ","juz":29,"page":568},{"n":42,"text":"وَلَا بِقَوۡلِ كَاهِنࣲۚ قَلِيلࣰا مَّا تَذَكَّرُونَ","juz":29,"page":568},{"n":43,"text":"تَنزِيلࣱ مِّن رَّبِّ ٱلۡعَٰلَمِينَ","juz":29,"page":568},{"n":44,"text":"وَلَوۡ تَقَوَّلَ عَلَيۡنَا بَعۡضَ ٱلۡأَقَاوِيلِ","juz":29,"page":568},{"n":45,"text":"لَأَخَذۡنَا مِنۡهُ بِٱلۡيَمِينِ","juz":29,"page":568},{"n":46,"text":"ثُمَّ لَقَطَعۡنَا مِنۡهُ ٱلۡوَتِينَ","juz":29,"page":568},{"n":47,"text":"فَمَا مِنكُم مِّنۡ أَحَدٍ عَنۡهُ حَٰجِزِينَ","juz":29,"page":568},{"n":48,"text":"وَإِنَّهُۥ لَتَذۡكِرَةࣱ لِّلۡمُتَّقِينَ","juz":29,"page":568},{"n":49,"text":"وَإِنَّا لَنَعۡلَمُ أَنَّ مِنكُم مُّكَذِّبِينَ","juz":29,"page":568},{"n":50,"text":"وَإِنَّهُۥ لَحَسۡرَةٌ عَلَى ٱلۡكَٰفِرِينَ","juz":29,"page":568},{"n":51,"text":"وَإِنَّهُۥ لَحَقُّ ٱلۡيَقِينِ","juz":29,"page":568},{"n":52,"text":"فَسَبِّحۡ بِٱسۡمِ رَبِّكَ ٱلۡعَظِيمِ","juz":29,"page":568}]}