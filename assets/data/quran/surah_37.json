":"فَسَاهَمَ فَكَانَ مِنَ ٱلۡمُدۡحَضِينَ","juz":23,"page":451},{"n":142,"text":"فَٱلۡتَقَمَهُ ٱلۡحُوتُ وَهُوَ مُلِيمࣱ‏","juz":23,"page":451},{"n":143,"text":"فَلَوۡلَآ أَنَّهُۥ كَانَ مِنَ ٱلۡمُسَبِّحِينَ","juz":23,"page":451},{"n":144,"text":"لَلَبِثَ فِي بَطۡنِهِۦٓ إِلَىٰ يَوۡمِ يُبۡعَثُونَ","juz":23,"page":451},{"n":145,"text":"۞فَنَبَذۡنَٰهُ بِٱلۡعَرَآءِ وَهُوَ سَقِيمࣱ‏","juz":23,"page":451},{"n":146,"text":"وَأَنۢبَتۡنَا عَلَيۡهِ شَجَرَةࣰ مِّن يَقۡطِينࣲ‏","juz":23,"page":451},{"n":147,"text":"وَأَرۡسَلۡنَٰهُ إِلَىٰ مِاْئَةِ أَلۡفٍ أَوۡ يَزِيدُونَ","juz":23,"page":451},{"n":148,"text":"فَـَٔامَنُواْ فَمَتَّعۡنَٰهُمۡ إِلَىٰ حِينࣲ‏","juz":23,"page":451},{"n":149,"text":"فَٱسۡتَفۡتِهِمۡ أَلِرَبِّكَ ٱلۡبَنَاتُ وَلَهُمُ ٱلۡبَنُونَ","juz":23,"page":451},{"n":150,"text":"أَمۡ خَلَقۡنَا ٱلۡمَلَٰٓئِكَةَ إِنَٰثࣰا وَهُمۡ شَٰهِدُونَ","juz":23,"page":451},{"n":151,"text":"أَلَآ إِنَّهُم مِّنۡ إِفۡكِهِمۡ لَيَقُولُونَ","juz":23,"page":451},{"n":152,"text":"وَلَدَ ٱللَّهُ وَإِنَّهُمۡ لَكَٰذِبُونَ","juz":23,"page":451},{"n":153,"text":"أَصۡطَفَى ٱلۡبَنَاتِ عَلَى ٱلۡبَنِينَ","juz":23,"page":451},{"n":154,"text":"مَا لَكُمۡ كَيۡفَ تَحۡكُمُونَ","juz":23,"page":452},{"n":155,"text":"أَفَلَا تَذَكَّرُونَ","juz":23,"page":452},{"n":156,"text":"أَمۡ لَكُمۡ سُلۡطَٰنࣱ مُّبِينࣱ‏","juz":23,"page":452},{"n":157,"text":"فَأۡتُواْ بِكِتَٰبِكُمۡ إِن كُنتُمۡ صَٰدِقِينَ","juz":23,"page":452},{"n":158,"text":"وَجَعَلُواْ بَيۡنَهُۥ وَبَيۡنَ ٱلۡجِنَّةِ نَسَبࣰاۚ وَلَقَدۡ عَلِمَتِ ٱلۡجِنَّةُ إِنَّهُمۡ لَمُحۡضَرُونَ","juz":23,"page":452},{"n":159,"text":"سُبۡحَٰنَ ٱللَّهِ عَمَّا يَصِفُونَ","juz":23,"page":452},{"n":160,"text":"إِلَّا عِبَادَ ٱللَّهِ ٱلۡمُخۡلَصِينَ","juz":23,"page":452},{"n":161,"text":"فَإِنَّكُمۡ وَمَا تَعۡبُدُونَ","juz":23,"page":452},{"n":162,"text":"مَآ أَنتُمۡ عَلَيۡهِ بِفَٰتِنِينَ","juz":23,"page":452},{"n":163,"text":"إِلَّا مَنۡ هُوَ صَالِ ٱلۡجَحِيمِ","juz":23,"page":452},{"n":164,"text":"وَمَا مِنَّآ إِلَّا لَهُۥ مَقَامࣱ مَّعۡلُومࣱ‏","juz":23,"page":452},{"n":165,"text":"وَإِنَّا لَنَحۡنُ ٱلصَّآفُّونَ","juz":23,"page":452},{"n":166,"text":"وَإِنَّا لَنَحۡنُ ٱلۡمُسَبِّحُونَ","juz":23,"page":452},{"n":167,"text":"وَإِن كَانُواْ لَيَقُولُونَ","juz":23,"page":452},{"n":168,"text":"لَوۡ أَنَّ عِندَنَا ذِكۡرࣰا مِّنَ ٱلۡأَوَّلِينَ","juz":23,"page":452},{"n":169,"text":"لَكُنَّا عِبَادَ ٱللَّهِ ٱلۡمُخۡلَصِينَ","juz":23,"page":452},{"n":170,"text":"فَكَفَرُواْ بِهِۦۖ فَسَوۡفَ يَعۡلَمُونَ","juz":23,"page":452},{"n":171,"text":"وَلَقَدۡ سَبَقَتۡ كَلِمَتُنَا لِعِبَادِنَا ٱلۡمُرۡسَلِينَ","juz":23,"page":452},{"n":172,"text":"إِنَّهُمۡ لَهُمُ ٱلۡمَنصُورُونَ","juz":23,"page":452},{"n":173,"text":"وَإِنَّ جُندَنَا لَهُمُ ٱلۡغَٰلِبُونَ","juz":23,"page":452},{"n":174,"text":"فَتَوَلَّ عَنۡهُمۡ حَتَّىٰ حِينࣲ‏","juz":23,"page":452},{"n":175,"text":"وَأَبۡصِرۡهُمۡ فَسَوۡفَ يُبۡصِرُونَ","juz":23,"page":452},{"n":176,"text":"أَفَبِعَذَابِنَا يَسۡتَعۡجِلُونَ","juz":23,"page":452},{"n":177,"text":"فَإِذَا نَزَلَ بِسَاحَتِهِمۡ فَسَآءَ صَبَاحُ ٱلۡمُنذَرِينَ","juz":23,"page":452},{"n":178,"text":"وَتَوَلَّ عَنۡهُمۡ حَتَّىٰ حِينࣲ‏","juz":23,"page":452},{"n":179,"text":"وَأَبۡصِرۡ فَسَوۡفَ يُبۡصِرُونَ","juz":23,"page":452},{"n":180,"text":"سُبۡحَٰنَ رَبِّكَ رَبِّ ٱلۡعِزَّةِ عَمَّا يَصِفُونَ","juz":23,"page":452},{"n":181,"text":"وَسَلَٰمٌ عَلَى ٱلۡمُرۡسَلِينَ","juz":23,"page":452},{"n":182,"text":"وَٱلۡحَمۡدُ لِلَّهِ رَبِّ ٱلۡعَٰلَمِينَ","juz":23,"page":452}]}