{"number":37,"name":"الصَّافَّاتِ","ayahs":[{"n":1,"text":"وَٱلصَّٰٓفَّٰتِ صَفࣰّا","juz":23,"page":446},{"n":2,"text":"فَٱلزَّٰجِرَٰتِ زَجۡرࣰا","juz":23,"page":446},{"n":3,"text":"فَٱلتَّٰلِيَٰتِ ذِكۡرًا","juz":23,"page":446},{"n":4,"text":"إِنَّ إِلَٰهَكُمۡ لَوَٰحِدࣱ‏","juz":23,"page":446},{"n":5,"text":"رَّبُّ ٱلسَّمَٰوَٰتِ وَٱلۡأَرۡضِ وَمَا بَيۡنَهُمَا وَرَبُّ ٱلۡمَشَٰرِقِ","juz":23,"page":446},{"n":6,"text":"إِنَّا زَيَّنَّا ٱلسَّمَآءَ ٱلدُّنۡيَا بِزِينَةٍ ٱلۡكَوَاكِبِ","juz":23,"page":446},{"n":7,"text":"وَحِفۡظࣰا مِّن كُلِّ شَيۡطَٰنࣲ مَّارِدࣲ‏","juz":23,"page":446},{"n":8,"text":"لَّا يَسَّمَّعُونَ إِلَى ٱلۡمَلَإِ ٱلۡأَعۡلَىٰ وَيُقۡذَفُونَ مِن كُلِّ جَانِبࣲ‏","juz":23,"page":446},{"n":9,"text":"دُحُورࣰاۖ وَلَهُمۡ عَذَابࣱ وَاصِبٌ","juz":23,"page":446},{"n":10,"text":"إِلَّا مَنۡ خَطِفَ ٱلۡخَطۡفَةَ فَأَتۡبَعَهُۥ شِهَابࣱ ثَاقِبࣱ‏","juz":23,"page":446},{"n":11,"text":"فَٱسۡتَفۡتِهِمۡ أَهُمۡ أَشَدُّ خَلۡقًا أَم مَّنۡ خَلَقۡنَآۚ إِنَّا خَلَقۡنَٰهُم مِّن طِينࣲ لَّازِبِۭ","juz":23,"page":446},{"n":12,"text":"بَلۡ عَجِبۡتَ وَيَسۡخَرُونَ","juz":23,"page":446},{"n":13,"text":"وَإِذَا ذُكِّرُواْ لَا يَذۡكُرُونَ","juz":23,"page":446},{"n":14,"text":"وَإِذَا رَأَوۡاْ ءَايَةࣰ يَسۡتَسۡخِرُونَ","juz":23,"page":446},{"n":15,"text":"وَقَالُوٓاْ إِنۡ هَٰذَآ إِلَّا سِحۡرࣱ مُّبِينٌ","juz":23,"page":446},{"n":16,"text":"أَءِذَا مِتۡنَا وَكُنَّا تُرَابࣰا وَعِظَٰمًا أَءِنَّا لَمَبۡعُوثُونَ","juz":23,"page":446},{"n":17,"text":"أَوَءَابَآؤُنَا ٱلۡأَوَّلُونَ","juz":23,"page":446},{"n":18,"text":"قُلۡ نَعَمۡ وَأَنتُمۡ دَٰخِرُونَ","juz":23,"page":446},{"n":19,"text":"فَإِنَّمَا هِيَ زَجۡرَةࣱ وَٰحِدَةࣱ فَإِذَا هُمۡ يَنظُرُونَ","juz":23,"page":446},{"n":20,"text":"وَقَالُواْ يَٰوَيۡلَنَا هَٰذَا يَوۡمُ ٱلدِّينِ","juz":23,"page":446},{"n":21,"text":"هَٰذَا يَوۡمُ ٱلۡفَصۡلِ ٱلَّذِي كُنتُم بِهِۦ تُكَذِّبُونَ","juz":23,"page":446},{"n":22,"text":"۞ٱحۡشُرُواْ ٱلَّذِينَ ظَلَمُواْ وَأَزۡوَٰجَهُمۡ وَمَا كَانُواْ يَعۡبُدُونَ","juz":23,"page":446},{"n":23,"text":"مِن دُونِ ٱللَّهِ فَٱهۡدُوهُمۡ إِلَىٰ صِرَٰطِ ٱلۡجَحِيمِ","juz":23,"page":446},{"n":24,"text":"وَقِفُوهُمۡۖ إِنَّهُم مَّسۡـُٔولُونَ","juz":23,"page":446},{"n":25,"text":"مَا لَكُمۡ لَا تَنَاصَرُونَ","juz":23,"page":447},{"n":26,"text":"بَلۡ هُمُ ٱلۡيَوۡمَ مُسۡتَسۡلِمُونَ","juz":23,"page":447},{"n":27,"text":"وَأَقۡبَلَ بَعۡضُهُمۡ عَلَىٰ بَعۡضࣲ يَتَسَآءَلُونَ","juz":23,"page":447},{"n":28,"text":"قَالُوٓاْ إِنَّكُمۡ كُنتُمۡ تَأۡتُونَنَا عَنِ ٱلۡيَمِينِ","juz":23,"page":447},{"n":29,"text":"قَالُواْ بَل لَّمۡ تَكُونُواْ مُؤۡمِنِينَ","juz":23,"page":447},{"n":30,"text":"وَمَا كَانَ لَنَا عَلَيۡكُم مِّن سُلۡطَٰنِۭۖ بَلۡ كُنتُمۡ قَوۡمࣰا طَٰغِينَ","juz":23,"page":447},{"n":31,"text":"فَحَقَّ عَلَيۡنَا قَوۡلُ رَبِّنَآۖ إِنَّا لَذَآئِقُونَ","juz":23,"page":447},{"n":32,"text":"فَأَغۡوَيۡنَٰكُمۡ إِنَّا كُنَّا غَٰوِينَ","juz":23,"page":447},{"n":33,"text":"فَإِنَّهُمۡ يَوۡمَئِذࣲ فِي ٱلۡعَذَابِ مُشۡتَرِكُونَ","juz":23,"page":447},{"n":34,"text":"إِنَّا كَذَٰلِكَ نَفۡعَلُ بِٱلۡمُجۡرِمِينَ","juz":23,"page":447},{"n":35,"text":"إِنَّهُمۡ كَانُوٓاْ إِذَا قِيلَ لَهُمۡ لَآ إِلَٰهَ إِلَّا ٱللَّهُ يَسۡتَكۡبِرُونَ","juz":23,"page":447},{"n":36,"text":"وَيَقُولُونَ أَئِنَّا لَتَارِكُوٓاْ ءَالِهَتِنَا لِشَاعِرࣲ مَّجۡنُونِۭ","juz":23,"page":447},{"n":37,"text":"بَلۡ جَآءَ بِٱلۡحَقِّ وَصَدَّقَ ٱلۡمُرۡسَلِينَ","juz":23,"page":447},{"n":38,"text":"إِنَّكُمۡ لَذَآئِقُواْ ٱلۡعَذَابِ ٱلۡأَلِيمِ","juz":23,"page":447},{"n":39,"text":"وَمَا تُجۡزَوۡنَ إِلَّا مَا كُنتُمۡ تَعۡمَلُونَ","juz":23,"page":447},{"n":40,"text":"إِلَّا عِبَادَ ٱللَّهِ ٱلۡمُخۡلَصِينَ","juz":23,"page":447},{"n":41,"text":"أُوْلَٰٓئِكَ لَهُمۡ رِزۡقࣱ مَّعۡلُومࣱ‏","juz":23,"page":447},{"n":42,"text":"فَوَٰكِهُ وَهُم مُّكۡرَمُونَ","juz":23,"page":447},{"n":43,"text":"فِي جَنَّٰتِ ٱلنَّعِيمِ","juz":23,"page":447},{"n":44,"text":"عَلَىٰ سُرُرࣲ مُّتَقَٰبِلِينَ","juz":23,"page":447},{"n":45,"text":"يُطَافُ عَلَيۡهِم بِكَأۡسࣲ مِّن مَّعِينِۭ","juz":23,"page":447},{"n":46,"text":"بَيۡضَآءَ لَذَّةࣲ لِّلشَّٰرِبِينَ","juz":23,"page":447},{"n":47,"text":"لَا فِيهَا غَوۡلࣱ وَلَا هُمۡ عَنۡهَا يُنزَفُونَ","juz":23,"page":447},{"n":48,"text":"وَعِندَهُمۡ قَٰصِرَٰتُ ٱلطَّرۡفِ عِينࣱ‏","juz":23,"page":447},{"n":49,"text":"كَأَنَّهُنَّ بَيۡضࣱ مَّكۡنُونࣱ‏","juz":23,"page":447},{"n":50,"text":"فَأَقۡبَلَ بَعۡضُهُمۡ عَلَىٰ بَعۡضࣲ يَتَسَآءَلُونَ","juz":23,"page":447},{"n":51,"text":"قَالَ قَآئِلࣱ مِّنۡهُمۡ إِنِّي كَانَ لِي قَرِينࣱ‏","juz":23,"page":447},{"n":52,"text":"يَقُولُ أَءِنَّكَ لَمِنَ ٱلۡمُصَدِّقِينَ","juz":23,"page":448},{"n":53,"text":"أَءِذَا مِتۡنَا وَكُنَّا تُرَابࣰا وَعِظَٰمًا أَءِنَّا لَمَدِينُونَ","juz":23,"page":448},{"n":54,"text":"قَالَ هَلۡ أَنتُم مُّطَّلِعُونَ","juz":23,"page":448},{"n":55,"text":"فَٱطَّلَعَ فَرَءَاهُ فِي سَوَآءِ ٱلۡجَحِيمِ","juz":23,"page":448},{"n":56,"text":"قَالَ تَٱللَّهِ إِن كِدتَّ لَتُرۡدِينِ","juz":23,"page":448},{"n":57,"text":"وَلَوۡلَا نِعۡمَةُ رَبِّي لَكُنتُ مِنَ ٱلۡمُحۡضَرِينَ","juz":23,"page":448},{"n":58,"text":"أَفَمَا نَحۡنُ بِمَيِّتِينَ","juz":23,"page":448},{"n":59,"text":"إِلَّا مَوۡتَتَنَا ٱلۡأُولَىٰ وَمَا نَحۡنُ بِمُعَذَّبِينَ","juz":23,"page":448},{"n":60,"text":"إِنَّ هَٰذَا لَهُوَ ٱلۡفَوۡزُ ٱلۡعَظِيمُ","juz":23,"page":448},{"n":61,"text":"لِمِثۡلِ هَٰذَا فَلۡيَعۡمَلِ ٱلۡعَٰمِلُونَ","juz":23,"page":448},{"n":62,"text":"أَذَٰلِكَ خَيۡرࣱ نُّزُلًا أَمۡ شَجَرَةُ ٱلزَّقُّومِ","juz":23,"page":448},{"n":63,"text":"إِنَّا جَعَلۡنَٰهَا فِتۡنَةࣰ لِّلظَّٰلِمِينَ","juz":23,"page":448},{"n":64,"text":"إِنَّهَا شَجَرَةࣱ تَخۡرُجُ فِيٓ أَصۡلِ ٱلۡجَحِيمِ","juz":23,"page":448},{"n":65,"text":"طَلۡعُهَا كَأَنَّهُۥ رُءُوسُ ٱلشَّيَٰطِينِ","juz":23,"page":448},{"n":66,"text":"فَإِنَّهُمۡ لَأٓكِلُونَ مِنۡهَا فَمَالِـُٔونَ مِنۡهَا ٱلۡبُطُونَ","juz":23,"page":448},{"n":67,"text":"ثُمَّ إِنَّ لَهُمۡ عَلَيۡهَا لَشَوۡبࣰا مِّنۡ حَمِيمࣲ‏","juz":23,"page":448},{"n":68,"text":"ثُمَّ إِنَّ مَرۡجِعَهُمۡ لَإِلَى ٱلۡجَحِيمِ","juz":23,"page":448},{"n":69,"text":"إِنَّهُمۡ أَلۡفَوۡاْ ءَابَآءَهُمۡ ضَآلِّينَ","juz":23,"page":448},{"n":70,"text":"فَهُمۡ عَلَىٰٓ ءَاثَٰرِهِمۡ يُهۡرَعُونَ","juz":23,"page":448},{"n":71,"text":"وَلَقَدۡ ضَلَّ قَبۡلَهُمۡ أَكۡثَرُ ٱلۡأَوَّلِينَ","juz":23,"page":448},{"n":72,"text":"وَلَقَدۡ أَرۡسَلۡنَا فِيهِم مُّنذِرِينَ","juz":23,"page":448},{"n":73,"text":"فَٱنظُرۡ كَيۡفَ كَانَ عَٰقِبَةُ ٱلۡمُنذَرِينَ","juz":23,"page":448},{"n":74,"text":"إِلَّا عِبَادَ ٱللَّهِ ٱلۡمُخۡلَصِينَ","juz":23,"page":448},{"n":75,"text":"وَلَقَدۡ نَادَىٰنَا نُوحࣱ فَلَنِعۡمَ ٱلۡمُجِيبُونَ","juz":23,"page":448},{"n":76,"text":"وَنَجَّيۡنَٰهُ وَأَهۡلَهُۥ مِنَ ٱلۡكَرۡبِ ٱلۡعَظِيمِ","juz":23,"page":448},{"n":77,"text":"وَجَعَلۡنَا ذُرِّيَّتَهُۥ هُمُ ٱلۡبَاقِينَ","juz":23,"page":449},{"n":78,"text":"وَتَرَكۡنَا عَلَيۡهِ فِي ٱلۡأٓخِرِينَ","juz":23,"page":449},{"n":79,"text":"سَلَٰمٌ عَلَىٰ نُوحࣲ فِي ٱلۡعَٰلَمِينَ","juz":23,"page":449},{"n":80,"text":"إِنَّا كَذَٰلِكَ نَجۡزِي ٱلۡمُحۡسِنِينَ","juz":23,"page":449},{"n":81,"text":"إِنَّهُۥ مِنۡ عِبَادِنَا ٱلۡمُؤۡمِنِينَ","juz":23,"page":449},{"n":82,"text":"ثُمَّ أَغۡرَقۡنَا ٱلۡأٓخَرِينَ","juz":23,"page":449},{"n":83,"text":"۞وَإِنَّ مِن شِيعَتِهِۦ لَإِبۡرَٰهِيمَ","juz":23,"page":449},{"n":84,"text":"إِذۡ جَآءَ رَبَّهُۥ بِقَلۡبࣲ سَلِيمٍ","juz":23,"page":449},{"n":85,"text":"إِذۡ قَالَ لِأَبِيهِ وَقَوۡمِهِۦ مَاذَا تَعۡبُدُونَ","juz":23,"page":449},{"n":86,"text":"أَئِفۡكًا ءَالِهَةࣰ دُونَ ٱللَّهِ تُرِيدُونَ","juz":23,"page":449},{"n":87,"text":"فَمَا ظَنُّكُم بِرَبِّ ٱلۡعَٰلَمِينَ","juz":23,"page":449},{"n":88,"text":"فَنَظَرَ نَظۡرَةࣰ فِي ٱلنُّجُومِ","juz":23,"page":449},{"n":89,"text":"فَقَالَ إِنِّي سَقِيمࣱ‏","juz":23,"page":449},{"n":90,"text":"فَتَوَلَّوۡاْ عَنۡهُ مُدۡبِرِينَ","juz":23,"page":449},{"n":91,"text":"فَرَاغَ إِلَىٰٓ ءَالِهَتِهِمۡ فَقَالَ أَلَا تَأۡكُلُونَ","juz":23,"page":449},{"n":92,"text":"مَا لَكُمۡ لَا تَنطِقُونَ","juz":23,"page":449},{"n":93,"text":"فَرَاغَ عَلَيۡهِمۡ ضَرۡبَۢا بِٱلۡيَمِينِ","juz":23,"page":449},{"n":94,"text":"فَأَقۡبَلُوٓاْ إِلَيۡهِ يَزِفُّونَ","juz":23,"page":449},{"n":95,"text":"قَالَ أَتَعۡبُدُونَ مَا تَنۡحِتُونَ","juz":23,"page":449},{"n":96,"text":"وَٱللَّهُ خَلَقَكُمۡ وَمَا تَعۡمَلُونَ","juz":23,"page":449},{"n":97,"text":"قَالُواْ ٱبۡنُواْ لَهُۥ بُنۡيَٰنࣰا فَأَلۡقُوهُ فِي ٱلۡجَحِيمِ","juz":23,"page":449},{"n":98,"text":"فَأَرَادُواْ بِهِۦ كَيۡدࣰا فَجَعَلۡنَٰهُمُ ٱلۡأَسۡفَلِينَ","juz":23,"page":449},{"n":99,"text":"وَقَالَ إِنِّي ذَاهِبٌ إِلَىٰ رَبِّي سَيَهۡدِينِ","juz":23,"page":449},{"n":100,"text":"رَبِّ هَبۡ لِي مِنَ ٱلصَّٰلِحِينَ","juz":23,"page":449},{"n":101,"text":"فَبَشَّرۡنَٰهُ بِغُلَٰمٍ حَلِيمࣲ‏","juz":23,"page":449},{"n":102,"text":"فَلَمَّا بَلَغَ مَعَهُ ٱلسَّعۡيَ قَالَ يَٰبُنَيَّ إِنِّيٓ أَرَىٰ فِي ٱلۡمَنَامِ أَنِّيٓ أَذۡبَحُكَ فَٱنظُرۡ مَاذَا تَرَىٰۚ قَالَ يَٰٓأَبَتِ ٱفۡعَلۡ مَا تُؤۡمَرُۖ سَتَجِدُنِيٓ إِن شَآءَ ٱللَّهُ مِنَ ٱلصَّٰبِرِينَ","juz":23,"page":449},{"n":103,"text":"فَلَمَّآ أَسۡلَمَا وَتَلَّهُۥ لِلۡجَبِينِ","juz":23,"page":450},{"n":104,"text":"وَنَٰدَيۡنَٰهُ أَن يَٰٓإِبۡرَٰهِيمُ","juz":23,"page":450},{"n":105,"text":"قَدۡ صَدَّقۡتَ ٱلرُّءۡيَآۚ إِنَّا كَذَٰلِكَ نَجۡزِي ٱلۡمُحۡسِنِينَ","juz":23,"page":450},{"n":106,"text":"إِنَّ هَٰذَا لَهُوَ ٱلۡبَلَٰٓؤُاْ ٱلۡمُبِينُ","juz":23,"page":450},{"n":107,"text":"وَفَدَيۡنَٰهُ بِذِبۡحٍ عَظِيمࣲ‏","juz":23,"page":450},{"n":108,"text":"وَتَرَكۡنَا عَلَيۡهِ فِي ٱلۡأٓخِرِينَ","juz":23,"page":450},{"n":109,"text":"سَلَٰمٌ عَلَىٰٓ إِبۡرَٰهِيمَ","juz":23,"page":450},{"n":110,"text":"كَذَٰلِكَ نَجۡزِي ٱلۡمُحۡسِنِينَ","juz":23,"page":450},{"n":111,"text":"إِنَّهُۥ مِنۡ عِبَادِنَا ٱلۡمُؤۡمِنِينَ","juz":23,"page":450},{"n":112,"text":"وَبَشَّرۡنَٰهُ بِإِسۡحَٰقَ نَبِيࣰّا مِّنَ ٱلصَّٰلِحِينَ","juz":23,"page":450},{"n":113,"text":"وَبَٰرَكۡنَا عَلَيۡهِ وَعَلَىٰٓ إِسۡحَٰقَۚ وَمِن ذُرِّيَّتِهِمَا مُحۡسِنࣱ وَظَالِمࣱ لِّنَفۡسِهِۦ مُبِينࣱ‏","juz":23,"page":450},{"n":114,"text":"وَلَقَدۡ مَنَنَّا عَلَىٰ مُوسَىٰ وَهَٰرُونَ","juz":23,"page":450},{"n":115,"text":"وَنَجَّيۡنَٰهُمَا وَقَوۡمَهُمَا مِنَ ٱلۡكَرۡبِ ٱلۡعَظِيمِ","juz":23,"page":450},{"n":116,"text":"وَنَصَرۡنَٰهُم